{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "app.locked.contactsMessage": {
      "comment": "Message under the locked placeholder: contacts can only be read after the account is opened (unlocked).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open this account before reading contacts."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "请先打开此账户，再查看联系人。"
          }
        }
      }
    },
    "app.background.releaseStorageTask": {
      "comment": "Name of the short background task that closes account storage when the app leaves the screen. Appears only in system diagnostics.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Release account storage"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "释放账户存储"
          }
        }
      }
    },
    "app.locked.conversationMessage": {
      "comment": "Message under the locked placeholder: a conversation can only be read after the account is opened (unlocked).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open this account before reading a conversation."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "请先打开此账户，再查看会话。"
          }
        }
      }
    },
    "RF_PUSH_MESSAGE": {
      "comment": "Body of a push notification for a new message, resolved by the system from the push's localization key. It names no sender and shows no message text; keep it generic.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New message"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "新消息"
          }
        }
      }
    },
    "RF_PUSH_CALL": {
      "comment": "Body of a push notification for an incoming call, resolved by the system from the push's localization key. It names no caller; keep it generic.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Incoming call"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "来电"
          }
        }
      }
    },
    "RF_PUSH_TEST": {
      "comment": "Body of a push notification the user asked for to check that notifications reach this phone, resolved by the system from the push's localization key.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Test notification"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "测试通知"
          }
        }
      }
    },
    "app.removed.notice": {
      "comment": "Notice shown after a locked account was removed from this device.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account removed from this device."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "已从本设备移除此账户。"
          }
        }
      },
      "extractionState": "manual"
    }
  }
}
