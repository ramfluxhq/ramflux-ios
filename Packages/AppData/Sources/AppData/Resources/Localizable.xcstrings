    "copy.90e302595fee": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Editing, reactions and replies require the updated message service."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑、表情回应和引用回复需要更新后的消息服务。"
