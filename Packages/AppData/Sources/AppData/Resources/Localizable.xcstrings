      }
    },
    "copy.c3654c6a066c": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This build cannot open the account service. Your saved data has not been changed."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本无法打开账户服务。已保存的数据未被更改。"
