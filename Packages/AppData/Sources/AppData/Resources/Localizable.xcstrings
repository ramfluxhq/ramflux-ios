            "value": "暂不可用"
          }
        }
      }
    },
    "copy.79ee17726170": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This archive exceeds the 256 MiB mobile import limit."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此归档超过手机端 256 MiB 的导入上限。"
          }
        }
      }
    },
    "copy.7cca3d86d331": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account services are unavailable in this build. Saved data has not been changed."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本的账户服务不可用。已保存的数据未被更改。"
          }
        }
      }
    },
    "copy.7fe3baa7c52d": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The service returned information this app cannot display."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "服务返回了此应用无法显示的信息。"
          }
