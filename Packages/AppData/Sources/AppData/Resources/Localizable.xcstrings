    "copy.b72e06e9393e": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open-account and username reachability are not available in the account service yet. They are separate from automatically accepting requests."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "账户服务暂不支持公开账户和用户名查找。这些功能与自动接受请求相互独立。"
          }
        }
      }
    },
    "copy.c294a0b00e74": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your connection. Your local records and drafts are kept."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查连接。本地记录和草稿已保留。"
