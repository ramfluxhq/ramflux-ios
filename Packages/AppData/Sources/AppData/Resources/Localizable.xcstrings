    "copy.04d7b4833927": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Messages"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "消息"
          }
        }
      }
    },
    "copy.0e3b0c4afad6": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attachment transfer requires the phone file-storage integration. No file has been downloaded."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "附件传输需要手机文件存储集成。尚未下载任何文件。"
          }
        }
      }
    },
    "copy.11cc2995d69e": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account setup requires the phone's protected key provider."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "账户设置需要手机的受保护密钥服务。"
          }
        }
      }
    },
    "copy.1b6fe0889add": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The action may have completed. Check its current status before starting another attempt."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作可能已完成。请先核实当前状态，再开始其他操作。"
          }
        }
      }
    },
    "copy.25c796d9c8f8": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This message has no displayable text projection."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此消息没有可显示的文本。"
          }
        }
      }
    },
    "copy.25f5b958f6a6": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The verification operation is not bound to the exact fingerprint shown here. No new verification has been recorded."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "验证操作尚未绑定到这里显示的确切指纹。未记录新的验证结果。"
          }
        }
      }
    },
