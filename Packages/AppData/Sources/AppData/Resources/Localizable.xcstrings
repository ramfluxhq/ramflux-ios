    "copy.6dc7a42f5b47": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Batch decisions are not available yet. Review each request separately."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "暂不支持批量处理。请逐条审核请求。"
          }
        }
      }
    },
    "copy.70336657918f": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The phone pairing coordinator is not registered. No device code or authorization has been created."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "手机配对服务尚未注册。未创建设备代码或授权。"
          }
        }
      }
    },
    "copy.70de3acff368": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock this device before opening your local records."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "请先解锁此设备，再打开本地记录。"
          }
