          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "请求未能完成"
          }
        }
      }
    },
    "request.localStorage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The local file operation failed. Check available storage and file access before trying again."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "本地文件操作失败。请检查可用存储空间和文件访问权限后再重试。"
          }
        }
      }
    },
    "request.localFailure": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A local system operation could not complete. Keep the current state; reopen the screen to review it before retrying."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "本地系统操作未能完成。请保留当前状态；重新打开页面核对后再决定是否重试。"
          }
        }
      }
    },
    "refusal.invalid_argument.title": {
