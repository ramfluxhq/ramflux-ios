    "groups.unavailable.threads": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Group threads and forum posts are not available in this phone build."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此手机版本暂不支持群组线程和论坛帖子。"
          }
        }
      }
    },
    "groups.unavailable.transfer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ownership transfer requires the new owner’s authenticated acceptance and certificate. This phone integration does not provide that flow yet."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "转让群主身份需要新群主的已认证接受操作和证书。此手机集成暂不支持该流程。"
          }
        }
      }
    },
    "groups.unavailable.leave": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A dedicated leave-group flow is not available. Removing a device is not a substitute for leaving the account’s group."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "专用的退出群组流程暂不可用。移除某台设备并不等于账户退出群组。"
          }
        }
      }
    },
    "groups.unavailable.history": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changing new-member history policy is not available in the current SDK."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "当前 SDK 暂不支持更改新成员的历史记录策略。"
          }
        }
      }
    },
    "groups.unavailable.archive": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Group archive is not available in the current SDK."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "当前 SDK 暂不支持归档群组。"
          }
        }
      }
    },
    "groups.unavailable.permission": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device has no current root-qualified permission to manage this group. No management change has been submitted."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备当前没有与根身份绑定的群组管理权限。未提交任何管理变更。"
          }
        }
      }
    },
    "calls.audioUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voice audio is unavailable in this build. Starting or answering a call is not supported. You can review call history and end an existing call."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本暂不支持语音音频，无法发起或接听通话。你可以查看通话记录并结束现有通话。"
          }
        }
      }
    },
    "tasks.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent task creation and mobile approval/intervention decisions require additional verified context. Review these actions on a trusted client; no permission has been granted."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "智能体任务创建及移动端审批和干预决策需要额外的已验证上下文。请在受信任客户端审核；尚未授予任何权限。"
          }
        }
      }
    },
    "chat.send.deliveryFailed": {
      "comment": "Shown when the account service reports that sending failed; the original send can be retried.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account service reported delivery failed. The original operation is retained."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "账户服务报告发送失败。原始操作已保留。"
          }
        }
      }
    },
    "onboarding.failure.setupExpired": {
      "comment": "Shown when account setup timed out and must start again.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Setup expired. Start a new account ceremony."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "设置已过期。请重新开始账户设置。"
          }
        }
      }
    },
    "onboarding.failure.pairingUnavailable": {
      "comment": "Shown when this build cannot pair with another device; no pairing code was created.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This SDK has no registered phone pairing coordinator. No pairing code has been created."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此 SDK 没有已注册的手机配对服务。未创建配对码。"
          }
        }
      }
    },
    "cards.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Interactive cards are not available on this device yet. You can continue using messages and your account."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备暂不支持交互卡片。您可以继续使用消息和账户功能。"
          }
        }
      }
    },
    "onboarding.refusal.title": {
      "comment": "Title of an error during account setup.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account setup needs attention"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查账户设置"
          }
        }
      }
    },
    "onboarding.nodeRequired": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select a confirmed node before preparing your account."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "请先选择已确认的节点，再准备账户。"
          }
        }
      }
    },
    "onboarding.nodeKeyMismatch": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The operator key must match the discovered node key. Check it with the operator before confirming."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "运营方公钥必须与发现的节点公钥一致。请先向运营方核对，再确认。"
          }
        }
      }
    },
    "onboarding.vaultPermission": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app cannot access its private Keychain. Install a correctly signed build with the app’s Keychain entitlement."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此应用无法访问其私有钥匙串。请安装包含应用钥匙串权限且正确签名的版本。"
          }
        }
      }
    },
    "onboarding.vaultLocked": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The private Keychain is locked. Unlock this device and try again."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "私有钥匙串已锁定。请解锁此设备后重试。"
          }
        }
      }
    },
    "onboarding.vaultMissing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Required account credentials are missing from the private Keychain. Recover the account before continuing."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "私有钥匙串中缺少所需账户凭据。请先恢复账户。"
          }
        }
      }
    },
    "onboarding.vaultCorrupt": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The private Keychain credentials could not be verified. Recover the account before continuing."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "无法验证私有钥匙串中的凭据。请先恢复账户。"
          }
        }
      }
    },
    "onboarding.vaultBusy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The private Keychain is busy. Finish the current account operation and try again."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "私有钥匙串正忙。请完成当前账户操作后重试。"
          }
        }
      }
    },
    "onboarding.vaultUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The private Keychain provider is unavailable on this device."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备上的私有钥匙串提供程序不可用。"
          }
        }
      }
    },
    "onboarding.sdkRefusal": {
