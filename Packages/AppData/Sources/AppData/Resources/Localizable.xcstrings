{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "common.tab.messages": {
      "comment": "Name of the Messages tab and title of the conversation list.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Messages"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "消息"
          }
        }
      }
    },
    "chat.unavailable.attachmentTransfer": {
      "comment": "Shown when an attachment cannot be downloaded because file storage is not integrated yet.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attachment transfer requires the phone file-storage integration. No file has been downloaded."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "附件传输需要手机文件存储集成。尚未下载任何文件。"
          }
        }
      }
    },
    "session.unavailable.custodyProvider": {
      "comment": "Shown when account setup needs the phone's protected key provider, which is not available yet.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account setup requires the phone's protected key provider."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "账户设置需要手机的受保护密钥服务。"
          }
        }
      }
    },
    "failure.outcomeUnknown.message": {
      "comment": "Explanation when the app could not confirm whether an action finished.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The action may have completed. Check its current status before starting another attempt."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作可能已完成。请先核实当前状态，再开始其他操作。"
          }
        }
      }
    },
    "chat.message.unsupported": {
      "comment": "Placeholder for a message whose content cannot be shown as text.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This message has no displayable text projection."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此消息没有可显示的文本。"
          }
        }
      }
    },
    "contacts.unavailable.atomicVerification": {
      "comment": "Shown when marking a safety number as verified cannot be bound to the exact number on screen; nothing was recorded.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The verification operation is not bound to the exact fingerprint shown here. No new verification has been recorded."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "验证操作尚未绑定到这里显示的确切指纹。未记录新的验证结果。"
          }
        }
      }
    },
    "common.tab.agents": {
      "comment": "Name of the Agents tab (automated assistants the user manages).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agents"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "Agents"
          }
        }
      }
    },
    "failure.invalidInput.title": {
      "comment": "Short title when the entered data was rejected.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your input"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查输入内容"
          }
        }
      }
    },
    "common.tab.groups": {
      "comment": "Name of the Groups tab (group conversations).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Groups"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "群组"
          }
        }
      }
    },
    "contacts.unavailable.reporting": {
      "comment": "Shown when reporting a stranger is not available yet; declining or blocking still works.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stranger reporting is not available in the account service yet. Decline or block remains available."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "账户服务暂不支持举报陌生人。你仍可拒绝或屏蔽请求。"
          }
        }
      }
    },
    "failure.invalidData.title": {
      "comment": "Short title when the service returned data the app cannot read.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to read this information"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取此信息"
          }
        }
      }
    },
    "failure.sdkUnavailable.title": {
      "comment": "Short title when the account service library is not available in this build.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account services are unavailable"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "账户服务不可用"
          }
        }
      }
    },
    "failure.upgradeRequired.title": {
      "comment": "Short title when the app must be updated before it can continue.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An update is required"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "需要更新"
          }
        }
      }
    },
    "conversations.unavailable.search": {
      "comment": "Shown when local message search is not available in this build.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local message search is not available yet."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "暂不支持本地消息搜索。"
          }
        }
      }
    },
    "failure.locked.title": {
      "comment": "Short title when the account is locked and must be unlocked first.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock this account"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "解锁此账户"
          }
        }
      }
    },
    "conversations.unavailable.searchService": {
      "comment": "Shown when the account service does not offer local message search yet.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local message search is not available in the account service yet."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "账户服务暂不支持本地消息搜索。"
          }
        }
      }
    },
    "session.unavailable.featureNotInstalled": {
      "comment": "Shown when a feature module is not installed in this build.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This feature module is not installed yet."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未安装此功能模块。"
          }
        }
      }
    },
    "contacts.unavailable.batch": {
      "comment": "Shown when deciding several contact requests at once is not available yet.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Batch decisions are not available yet. Review each request separately."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "暂不支持批量处理。请逐条审核请求。"
          }
        }
      }
    },
    "settings.unavailable.pairing": {
      "comment": "Shown when linking another device is not available in this build; no code or authorization was created.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The phone pairing coordinator is not registered. No device code or authorization has been created."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "手机配对服务尚未注册。未创建设备代码或授权。"
          }
        }
      }
    },
    "failure.locked.message": {
      "comment": "Explanation when the device must be unlocked before local records can be opened.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock this device before opening your local records."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "请先解锁此设备，再打开本地记录。"
          }
        }
      }
    },
    "failure.unavailable.title": {
      "comment": "Short title when a feature is not available yet in this build.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not available yet"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "暂不可用"
          }
        }
      }
    },
    "backup.import.tooLarge": {
      "comment": "Shown when a backup archive is larger than the phone import limit. Keep \"256 MiB\" as written.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This archive exceeds the 256 MiB mobile import limit."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此归档超过手机端 256 MiB 的导入上限。"
          }
        }
      }
    },
    "session.unavailable.nativeCore": {
      "comment": "Shown when this build has no account service; reassures that saved data is unchanged.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account services are unavailable in this build. Saved data has not been changed."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本的账户服务不可用。已保存的数据未被更改。"
          }
        }
      }
    },
    "failure.invalidData.message": {
      "comment": "Explanation when the service returned data the app cannot read.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The service returned information this app cannot display."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "服务返回了此应用无法显示的信息。"
          }
        }
      }
    },
    "failure.invalidInput.message": {
      "comment": "Explanation when required fields are missing or invalid.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complete the required fields before continuing."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "请填写必填项后再继续。"
          }
        }
      }
    },
    "chat.unavailable.calls": {
      "comment": "Shown when calling is not available in this phone build.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calling is not available in this phone build."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此手机版本暂不支持通话。"
          }
        }
      }
    },
    "failure.resyncRequired.title": {
      "comment": "Short title asking the user to reload local records after missed updates.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh your local records"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "刷新本地记录"
          }
        }
      }
    },
    "chat.unavailable.details": {
      "comment": "Shown when conversation details are not available in this phone build.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversation details are not available in this phone build."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此手机版本暂不支持查看会话详情。"
          }
        }
      }
    },
    "failure.busy.title": {
      "comment": "Short title when the service is busy and the user should retry soon.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please try again shortly"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "请稍后重试"
          }
        }
      }
    },
    "failure.unsupported.message": {
      "comment": "Explanation when the account service does not support the requested action.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This action is not supported by the account service."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "账户服务不支持此操作。"
          }
        }
      }
    },
    "failure.outcomeUnknown.title": {
      "comment": "Short title when the app could not confirm whether an action finished.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Outcome not confirmed"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "结果尚未确认"
          }
        }
      }
    },
    "settings.unavailable.openAccount": {
      "comment": "Shown when being reachable by open account or username is not available yet; explains it differs from accepting requests automatically.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open-account and username reachability are not available in the account service yet. They are separate from automatically accepting requests."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "账户服务暂不支持公开账户和用户名查找。这些功能与自动接受请求相互独立。"
          }
        }
      }
    },
    "failure.offline.message": {
      "comment": "Explanation when there is no connection; local records and drafts are kept.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your connection. Your local records and drafts are kept."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查连接。本地记录和草稿已保留。"
          }
        }
      }
    },
    "failure.sdkUnavailable.message": {
      "comment": "Explanation when this build cannot open the account service; reassures that saved data is unchanged.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This build cannot open the account service. Your saved data has not been changed."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本无法打开账户服务。已保存的数据未被更改。"
          }
        }
      }
    },
    "settings.unavailable.connectedServices": {
      "comment": "Shown when advanced connected-service settings must be changed on the desktop app.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Advanced connected-service configuration is managed on your desktop."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "请在桌面端管理已连接服务的高级配置。"
          }
        }
      }
    },
    "common.tab.more": {
      "comment": "Name of the More tab, which lists the remaining sections of the app.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "更多"
          }
        }
      }
    },
    "failure.busy.message": {
      "comment": "Explanation when another operation or another writer of the account is still running.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another operation or account writer is still active."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "其他操作或账户写入进程仍在运行。"
          }
        }
      }
    },
    "failure.resyncRequired.message": {
      "comment": "Explanation that some updates were missed and a refresh reloads current records.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An update gap occurred. Refresh to load current records and reopen updates."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "更新出现中断。请刷新以加载最新记录并重新订阅更新。"
          }
        }
      }
    },
    "settings.unavailable.diagnosticExport": {
      "comment": "Shown when exporting diagnostics is not available; no private data was shared.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanitized diagnostic export is not available in this build. No private account data has been shared."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本暂不支持脱敏诊断导出。未共享任何账户隐私数据。"
          }
        }
      }
    },
    "common.connection.failed": {
      "comment": "Title shown when the app cannot reach the account service or the chosen node.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to connect"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接"
          }
        }
      }
    },
    "contacts.unavailable.replyWithoutAcceptance": {
      "comment": "Shown when replying to a request without accepting it is not available yet; no contact was accepted.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The service does not expose this request's reply conversation yet. No contact has been accepted."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "服务尚未提供此请求的回复会话。未接受任何联系人请求。"
          }
        }
      }
    },
    "contacts.unavailable.identityCommitment": {
      "comment": "Shown when the contact's current identity record cannot be read.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current contact identity commitment is unavailable."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "当前联系人的身份承诺不可用。"
          }
        }
      }
    },
    "failure.upgradeRequired.message": {
      "comment": "Explanation when the app must be updated before this account can be used.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update Ramflux before continuing with this account."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "请更新 Ramflux 后再继续使用此账户。"
          }
        }
      }
    },
    "status.backup": {
      "comment": "Noun: the kind of a backup job.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "备份"
          }
        }
      }
    },
    "status.restore": {
      "comment": "Noun: the kind of a restore job.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复"
          }
        }
      }
    },
    "status.preparing": {
      "comment": "Job progress: preparing.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparing"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "正在准备"
          }
        }
      }
    },
    "status.writing": {
      "comment": "Job progress: writing the archive.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Writing"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "正在写入"
          }
        }
      }
    },
    "status.verifying": {
      "comment": "Job progress: verifying the archive.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifying"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "正在验证"
          }
        }
      }
    },
    "status.verified": {
      "comment": "Job progress: the archive was verified.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verified"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "已验证"
          }
        }
      }
    },
    "status.installing": {
      "comment": "Job progress: installing a restored archive.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installing"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "正在安装"
          }
        }
      }
    },
    "status.done": {
      "comment": "State of a job that finished.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "已完成"
          }
        }
      }
    },
    "status.failed": {
      "comment": "State of a job that failed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Failed"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "失败"
          }
        }
      }
    },
    "status.cancelled": {
      "comment": "State of a job that was cancelled.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelled"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "已取消"
