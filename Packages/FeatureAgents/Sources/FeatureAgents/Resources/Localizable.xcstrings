{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "agents.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agents"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "智能体"
          }
        }
      }
    },
    "agents.profile": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent profile"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "智能体资料"
          }
        }
      }
    },
    "agents.goal": {
      "comment": "Field label: the responsibility or goal of an agent (an automated assistant).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Responsibility"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "职责"
          }
        }
      }
    },
    "agents.edit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit basics"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑基本信息"
          }
        }
      }
    },
    "agents.remove": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove Agent"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "移除智能体"
          }
        }
      }
    },
    "agents.name": {
      "comment": "Field label: the name of an agent.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "名称"
          }
        }
      }
    },
    "agents.loading": {
      "comment": "Progress label while the agent list loads.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading agents"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "正在加载智能体"
          }
        }
      }
    },
    "agents.retry": {
      "comment": "Button that checks agent availability again.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "重试"
          }
        }
      }
    },
    "agents.desktop": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create agents on your desktop"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "在桌面端创建智能体"
          }
        }
      }
    },
    "agents.empty.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No agents found"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "没有找到智能体"
          }
        }
      }
    },
    "agents.empty.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try another name or keyword."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "试试其他姓名或关键词。"
          }
        }
      }
    },
    "agents.search": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search by name…"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "按名称搜索…"
          }
        }
      }
    },
    "agents.multi": {
      "comment": "Action that starts one conversation with several agents.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start a multi-agent chat"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "发起多智能体聊天"
          }
        }
      }
    },
    "agents.directory.note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Collaboration settings and task status are shown separately."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "协作设置与任务状态分别显示。"
          }
        }
      }
    },
    "agents.loadingMore": {
      "comment": "Progress label at the end of the agent list while the next page loads.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading more agents"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "正在加载更多智能体"
          }
        }
      }
    },
    "agents.none.title": {
      "comment": "Title of the agent directory when the account has no agents.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No agents yet"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有智能体"
          }
        }
      }
    },
    "agents.none.message": {
      "comment": "Explains that agents are created on the desktop and then appear on the phone.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create an agent on your desktop. It appears here once it is ready."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "请在桌面端创建智能体，创建完成后会显示在这里。"
          }
        }
      }
    },
    "agents.save": {
      "comment": "Button that saves the edited agent profile.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "保存"
          }
        }
      }
    },
    "agents.edit.confirm": {
      "comment": "Confirmation text before saving a changed agent profile.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save these profile changes? Everyone who can reach this agent sees the new name and responsibility."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "保存这些资料修改？所有可以联系此智能体的人都会看到新的名称和职责。"
          }
        }
      }
    },
    "agents.remove.confirm": {
      "comment": "Confirmation text before deleting an agent.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete this agent? Its keys on this account are erased and it can no longer be reached. This cannot be undone."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "删除此智能体？它在此账户上的密钥将被清除，之后无法再联系它。此操作无法撤销。"
          }
        }
      }
    },
    "agents.cancel": {
      "comment": "Button that closes a confirmation without changing anything.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "agents.access": {
      "comment": "Section title on the agent profile: who may reach the agent.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Who can reach this agent"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "谁可以联系此智能体"
          }
        }
      }
    },
    "agents.access.dm": {
      "comment": "Label of the direct-message access policy of an agent.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct messages"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "私信"
          }
        }
      }
    },
    "agents.access.groups": {
      "comment": "Label of the group-invitation access policy of an agent.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Group invitations"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "群组邀请"
          }
        }
      }
    },
    "agents.access.change": {
      "comment": "Button that would change who may reach an agent.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change access"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "更改访问权限"
          }
        }
      }
    },
    "agents.creation.title": {
      "comment": "Title of the card for an agent creation started on the desktop that waits for this phone.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent creation waiting for you"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "有智能体创建等待你处理"
          }
        }
      }
    },
    "agents.creation.message": {
      "comment": "Explains the pending agent creation card.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your desktop asked to create an agent with this account. Review the request before it expires."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "你的桌面端请求使用此账户创建智能体。请在请求过期前处理。"
          }
        }
      }
    },
    "agents.creation.expires": {
      "comment": "Label before the expiry time of a pending agent creation.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expires"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "过期时间"
          }
        }
      }
    },
    "agents.creation.approve": {
      "comment": "Button that approves a desktop-started agent creation.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approve"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "批准"
          }
        }
      }
    },
    "agents.creation.decline": {
      "comment": "Button that declines a desktop-started agent creation.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Decline"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "拒绝"
          }
        }
      }
    }
  }
}
