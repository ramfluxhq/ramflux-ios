{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "common.appName": {
      "comment": "The product name. Keep it unchanged unless the product has an official localised name.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ramflux"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "Ramflux"
          }
        }
      }
    },
    "shell.loading.accountServices": {
      "comment": "Progress label while the account service starts.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opening account services"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "正在打开账户服务"
          }
        }
      }
    },
    "shell.accounts.empty.message": {
      "comment": "Explains that setting up or unlocking an account happens in the onboarding flow.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account setup and unlock belong to the onboarding module."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "请在账户设置中创建或解锁账户。"
          }
        }
      }
    },
    "settings.devices.title": {
      "comment": "Title of the list of the user's own linked devices.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My devices"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "我的设备"
          }
        }
      }
    },
    "settings.title": {
      "comment": "Title of the Settings screen.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "设置"
          }
        }
      }
    },
    "shell.accounts.empty.title": {
      "comment": "Title when no account is open on this phone.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No open accounts"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "没有已打开的账户"
          }
        }
      }
    },
    "shell.locked.accessibility": {
      "comment": "Accessibility label of the cover shown over the app while it is locked or inactive.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ramflux is locked"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "Ramflux 已锁定"
          }
        }
      }
    },
    "shell.session.account": {
      "comment": "Label in front of the identifier of the account in use.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "账户"
          }
        }
      }
    },
    "shell.accounts.title": {
      "comment": "Title of the account picker and of the button that opens it.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accounts"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "账户"
          }
        }
      }
    },
    "shell.unavailable.title": {
      "comment": "Title when the account service cannot be used.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account services unavailable"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "账户服务不可用"
          }
        }
      }
    },
    "common.tab.contacts": {
      "comment": "Title of the Contacts screen and label of the header button that opens it.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Contacts"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "联系人"
          }
        }
      }
    },
    "shell.stopped.title": {
      "comment": "Shown when the account service has been stopped.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account services are stopped"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "账户服务已停止"
          }
        }
      }
    },
    "shell.noAccount.title": {
      "comment": "Shown when no account is selected: choose one, or set up this phone once onboarding is available.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose an account or set up this phone when onboarding is available."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "选择账户，或设置此手机。"
          }
        }
      }
    },
    "account.add": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add account"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "添加账户"
          }
        }
      }
    },
    "common.nav.contacts": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Contacts"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "联系人"
          }
        }
      }
    },
    "common.nav.settings": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "设置"
          }
        }
      }
    },
    "common.nav.tasks": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasks"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "任务"
          }
        }
      }
    },
    "common.perm.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permissions and access"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "权限与访问"
          }
        }
      }
    },
    "settings.more.hub.access.preview": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device, group roles and this action"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "本设备、群组角色和本次操作"
          }
        }
      }
    },
    "settings.more.hub.contacts.preview": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Existing relationships and safety numbers"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "现有关系与安全号码"
          }
        }
      }
    },
    "settings.more.hub.settings.preview": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account, service and on-device preferences"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "账号、服务和本机偏好"
          }
        }
      }
    },
    "settings.more.hub.tasks.preview": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View tasks and pending items"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "查看任务与待处理事项"
          }
        }
      }
    },
    "shell.accounts.preview": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch the account on this phone"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "切换本机账号"
          }
        }
      }
    },
    "shell.notices.preview": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Font licenses bundled with this app"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "本应用附带的字体许可"
          }
        }
      }
    },
    "shell.notices.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open-source notices"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "开源声明"
          }
        }
      }
    },
    "shell.more.navigation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit navigation"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑导航"
          }
        }
      }
    },
    "shell.more.navigation.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrange shortcuts"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "整理快捷入口"
          }
        }
      }
    },
    "shell.nav.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit mobile navigation"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑移动导航"
          }
        }
      }
    },
    "shell.nav.note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes apply immediately · Close when done"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "修改即时生效 · 完成后关闭"
          }
        }
      }
    },
    "shell.nav.add": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add shortcut"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "添加快捷入口"
          }
        }
      }
    },
    "shell.nav.core": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Messages, Groups and Agents can be reordered but not removed."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "消息、群组、Agent 可调整顺序，不能移除。"
          }
        }
      }
    },
    "shell.nav.restore": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore defaults"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复默认"
          }
        }
      }
    },
    "shell.nav.done": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "完成"
          }
        }
      }
    },
    "shell.nav.up": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move up"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "上移"
          }
        }
      }
    },
    "shell.nav.down": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move down"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "下移"
          }
        }
      }
    },
    "shell.nav.remove": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "移除"
          }
        }
      }
    },
    "shell.nav.lock": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Locked"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "已锁定"
          }
        }
