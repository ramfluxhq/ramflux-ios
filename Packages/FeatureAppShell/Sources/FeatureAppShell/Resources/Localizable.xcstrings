{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "common.appName": {
      "comment": "The product name. Keep it unchanged unless the product has an official localised name.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ramflux"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "Ramflux"
          }
        }
      }
    },
    "shell.loading.accountServices": {
      "comment": "Progress label while the account service starts.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opening account services"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "正在打开账户服务"
          }
        }
      }
    },
    "shell.accounts.empty.message": {
      "comment": "Explains that setting up or unlocking an account happens in the onboarding flow.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account setup and unlock belong to the onboarding module."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "请在账户设置中创建或解锁账户。"
          }
        }
      }
    },
    "settings.devices.title": {
      "comment": "Title of the list of the user's own linked devices.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My devices"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "我的设备"
          }
        }
      }
    },
    "settings.title": {
      "comment": "Title of the Settings screen.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "设置"
          }
        }
      }
    },
    "shell.accounts.empty.title": {
      "comment": "Title when no account is open on this phone.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No open accounts"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "没有已打开的账户"
          }
        }
      }
    },
    "shell.locked.accessibility": {
      "comment": "Accessibility label of the cover shown over the app while it is locked or inactive.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ramflux is locked"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "Ramflux 已锁定"
          }
        }
      }
    },
    "shell.session.account": {
      "comment": "Label in front of the identifier of the account in use.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "账户"
          }
        }
      }
    },
    "shell.accounts.title": {
      "comment": "Title of the account picker and of the button that opens it.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accounts"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "账户"
          }
        }
      }
    },
    "shell.unavailable.title": {
      "comment": "Title when the account service cannot be used.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account services unavailable"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "账户服务不可用"
          }
        }
      }
    },
    "common.tab.contacts": {
      "comment": "Title of the Contacts screen and label of the header button that opens it.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Contacts"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "联系人"
          }
        }
      }
    },
    "shell.stopped.title": {
      "comment": "Shown when the account service has been stopped.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account services are stopped"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "账户服务已停止"
          }
        }
      }
    },
    "shell.noAccount.title": {
      "comment": "Shown when no account is selected: choose one, or set up this phone once onboarding is available.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose an account or set up this phone when onboarding is available."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "选择账户，或设置此手机。"
          }
        }
      }
    },
    "account.add": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add account"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "添加账户"
          }
        }
      }
    },
    "common.nav.contacts": {
      "comment": "Shortcut in the edit-navigation list that opens Contacts.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Contacts"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "联系人"
          }
        }
      }
    },
    "common.nav.settings": {
      "comment": "Shortcut in the edit-navigation list that opens Settings.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "设置"
          }
        }
      }
    },
    "common.nav.tasks": {
      "comment": "Shortcut in the edit-navigation list that opens Tasks.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasks"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "任务"
          }
        }
      }
    },
    "common.perm.title": {
      "comment": "Title of the More hub entry for permissions and access.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permissions and access"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "权限与访问"
          }
        }
      }
    },
    "settings.more.hub.access.preview": {
      "comment": "Subtitle of the permissions entry in the More hub, listing what it covers.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device, group roles and this action"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "本设备、群组角色和本次操作"
          }
        }
      }
    },
    "settings.more.hub.contacts.preview": {
      "comment": "Subtitle of the Contacts entry in the More hub.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Existing relationships and safety numbers"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "现有关系与安全号码"
          }
        }
      }
    },
    "settings.more.hub.settings.preview": {
      "comment": "Subtitle of the Settings entry in the More hub.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account, service and on-device preferences"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "账户、服务和本机偏好"
          }
        }
      }
    },
    "settings.more.hub.tasks.preview": {
      "comment": "Subtitle of the Tasks entry in the More hub.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View tasks and pending items"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "查看任务与待处理事项"
          }
        }
      }
    },
    "shell.accounts.preview": {
      "comment": "Subtitle of the Accounts entry in the More hub.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch the account on this phone"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "切换本机账户"
          }
        }
      }
    },
    "shell.notices.preview": {
      "comment": "Subtitle of the open-source notices entry.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Font licenses bundled with this app"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "本应用附带的字体许可"
          }
        }
      }
    },
    "shell.notices.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open-source notices"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "开源声明"
          }
        }
      }
    },
    "shell.more.navigation": {
      "comment": "More hub entry that opens the edit-navigation screen.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit navigation"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑导航"
          }
        }
      }
    },
    "shell.more.navigation.detail": {
      "comment": "Subtitle of the edit-navigation entry.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrange shortcuts"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "整理快捷入口"
          }
        }
      }
    },
    "shell.nav.title": {
      "comment": "Title of the screen for editing the bottom navigation on the phone.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit mobile navigation"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑移动导航"
          }
        }
      }
    },
    "shell.nav.note": {
      "comment": "Note under the edit-navigation list. Keep the separator style natural for the language.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes apply immediately · Close when done"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "修改即时生效 · 完成后关闭"
          }
        }
      }
    },
    "shell.nav.add": {
      "comment": "Button that adds a shortcut to the bottom navigation.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add shortcut"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "添加快捷入口"
          }
        }
      }
    },
    "shell.nav.core": {
      "comment": "Note in the navigation editor.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chats, Groups and Agents can be reordered but not removed."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "聊天、群组、智能体可调整顺序，不能移除。"
          }
        }
      }
    },
    "shell.nav.restore": {
      "comment": "Button that restores the default navigation order. It may wrap or stack in narrow layouts.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore defaults"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复默认"
          }
        }
      }
    },
    "shell.nav.done": {
      "comment": "Button that closes the edit-navigation screen.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "完成"
          }
        }
      }
    },
    "shell.nav.up": {
      "comment": "Accessibility action that moves a shortcut up one place.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move up"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "上移"
          }
        }
      }
    },
    "shell.nav.down": {
      "comment": "Accessibility action that moves a shortcut down one place.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move down"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "下移"
          }
        }
      }
    },
    "shell.nav.remove": {
      "comment": "Button that removes a shortcut from the bottom navigation.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "移除"
          }
        }
      }
    },
    "shell.nav.lock": {
      "comment": "Accessibility label of the lock icon on a core tab that cannot be removed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Locked"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "已锁定"
          }
        }
      }
    },
    "shell.more.calls": {
      "comment": "Row in the More hub that opens the call history.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calls"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "通话"
          }
        }
      }
    },
    "shell.more.calls.preview": {
      "comment": "Second line of the More hub row that opens the call history.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Call history and voice calls"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "通话记录与语音通话"
          }
        }
      }
    },
    "shell.accounts.locked": {
      "comment": "Trailing caption of an account row in the account switcher: the account is on this phone but locked.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Locked"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "已锁定"
          }
        }
      }
    },
    "banner.generic": {
      "comment": "Title of the in-app message banner when it must not show who wrote or what was written (screen recording, mirroring, locked app). Also the spoken label in that case.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New message"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "新消息"
          }
        }
      }
    },
    "banner.call": {
      "comment": "Second line of the in-app message banner for a call record.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Call"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "通话"
          }
        }
      }
    },
    "banner.other": {
      "comment": "Second line of the in-app message banner for a message that is not plain text (media, removed or unsupported content, system events).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New message"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "新消息"
          }
        }
      }
    },
    "banner.accessibility.from": {
      "comment": "Short spoken label of the in-app message banner. %@ is the sender or group name.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New message from %@"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "来自 %@ 的新消息"
          }
        }
      }
    },
    "banner.accessibility.dismiss": {
      "comment": "VoiceOver action name that dismisses the in-app message banner.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dismiss"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭"
          }
        }
      }
    },
    "shell.appLock.instructions": {
      "comment": "Shown on the lock page under the account name.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the account code for this account."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "输入此账户的账户码。"
          }
        }
      }
    },
    "shell.appLock.code": {
      "comment": "Label of the account code field on the app lock screen.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account code"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "账户码"
          }
        }
      }
    },
    "shell.appLock.wait": {
      "comment": "Status line while the account code is refused for a wait. %@ is the remaining time (m:ss).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many tries. Try again in %@."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "尝试次数过多。请在 %@ 后重试。"
          }
        }
      }
    },
    "shell.appLock.restore": {
      "comment": "Primary button on the exhausted app lock page that starts recovery with the recovery phrase and the account code.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recover with recovery phrase"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "用恢复短语恢复"
          }
        }
      }
    },
    "shell.appLock.exhausted.title": {
      "comment": "Title of the app lock page once the ten account-code checks are used up.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many wrong account codes"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "错误的账户码次数过多"
          }
        }
      },
      "extractionState": "manual"
    },
    "shell.appLock.exhausted.body": {
      "comment": "Body of the app lock page once the account-code checks are used up; it names the two ways out.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account is locked on this device. Recover it with its recovery phrase and account code, or remove it from this device."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此账户已在本设备上锁定。请用恢复短语和账户码恢复，或将其从本设备移除。"
          }
        }
      },
      "extractionState": "manual"
    },
    "shell.appLock.remove": {
      "comment": "Destructive button on the exhausted app lock page that opens the confirmation to remove the account from this device.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove from this device"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "从本设备移除"
          }
        }
      },
      "extractionState": "manual"
    },
    "shell.appLock.phraseAccepted": {
      "comment": "Shown on the app lock screen after the recovery phrase was accepted while the account-code wait still runs. %@ is the remaining wait as minutes and seconds, for example 0:30.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovery phrase accepted. You can enter your account code in %@."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复短语已确认。请在 %@ 后输入账户码。"
          }
        }
      },
      "extractionState": "manual"
    },
    "shell.appLock.remove.title": {
      "comment": "Title of the confirmation to remove a locked account from this device.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove this account from this device?"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "要从本设备移除此账户吗？"
          }
        }
      },
      "extractionState": "manual"
    },
    "shell.appLock.remove.body": {
      "comment": "Consequence text of the confirmation to remove a locked account from this device.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local history that is not in a backup is lost. This cannot be undone. You can restore the account later from a backup and its recovery phrase."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "未备份的本地记录将丢失，且无法撤销。之后可以用备份和恢复短语恢复此账户。"
          }
        }
      },
      "extractionState": "manual"
    },
