        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No answer"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "无人接听"
          }
        }
      }
    },
    "calls.failed": {
      "comment": "Call outcome: failed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Failed"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "失败"
          }
        }
      }
    },
    "calls.answered_elsewhere": {
      "comment": "Call outcome: answered on another device of the same account.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answered on another device"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "已在其他设备接听"
          }
        }
      }
