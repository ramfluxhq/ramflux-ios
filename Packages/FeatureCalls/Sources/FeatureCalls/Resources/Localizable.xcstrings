        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A signaling action is unresolved"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "信令操作的结果尚未确认"
          }
        }
      }
    },
    "calls.reconcile": {
      "comment": "Button that checks the result of a call action whose outcome is unknown.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconcile original signaling action"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "核实原始信令操作"
          }
        }
      }
    },
    "calls.review": {
      "comment": "Title of the confirmation for a call action.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review signaling action"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "审核信令操作"
          }
        }
      }
    },
    "calls.account": {
      "comment": "Label in front of the account identifier on a call detail.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "账户"
          }
        }
      }
    },
    "calls.sequence": {
      "comment": "Label in front of the call version number the app last saw.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Observed call version"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "已观察到的通话版本"
