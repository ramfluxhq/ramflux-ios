      "comment": "Microphone permission state: denied.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Denied"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "已拒绝"
          }
        }
