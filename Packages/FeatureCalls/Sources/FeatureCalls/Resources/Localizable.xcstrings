      "comment": "Call state: outgoing call, ringing. Keep the separator style natural for the language.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Outgoing call · ringing"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "正在呼叫 · 响铃中"
