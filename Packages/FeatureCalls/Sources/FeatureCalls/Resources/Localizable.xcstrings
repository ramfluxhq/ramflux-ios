    "calls.localFailure": {
      "comment": "Call end reason: a failure on this device.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device’s failure"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备上的故障"
          }
        }
