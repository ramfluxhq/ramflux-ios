    "calls.speaker": {
      "comment": "Call control that switches audio to the loudspeaker.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speaker"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "扬声器"
          }
