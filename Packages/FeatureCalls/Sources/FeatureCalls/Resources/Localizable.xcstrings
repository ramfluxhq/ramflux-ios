    "calls.reasonUnknown": {
      "comment": "Shown when the reason a call ended is unknown.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reason unavailable"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "原因不可用"
          }
        }
      }
    },
    "calls.authority_unavailable": {
      "comment": "Call end reason: the identity service was unavailable.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current identity authority is unavailable"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "当前身份授权不可用"
          }
        }
      }
    },
    "calls.authority_refused": {
      "comment": "Call end reason: the identity service refused the call.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Identity authority refused the call"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "身份授权拒绝了通话"
          }
        }
      }
    },
    "calls.relay_unavailable": {
      "comment": "Call end reason: the voice relay server was unavailable.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voice relay unavailable"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "语音中继不可用"
          }
        }
      }
    },
    "calls.media_lease_expired": {
      "comment": "Call end reason: the permission to use the media relay expired.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Media authorization expired"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "媒体授权已到期"
          }
        }
      }
    },
    "calls.daemon_restarted": {
      "comment": "Call end reason: the account service restarted.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account service restarted"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "账户服务已重启"
          }
        }
      }
    },
    "calls.signaling_unavailable": {
      "comment": "Call end reason: the call setup service was unavailable.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signaling unavailable"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "信令不可用"
          }
        }
      }
    },
    "calls.stale": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last confirmed call status. Refresh before applying an action."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "这是上次已确认的通话状态。执行操作前请刷新。"
          }
        }
      }
    },
    "calls.pending": {
      "comment": "Warning that an earlier call action has no confirmed result yet.",
