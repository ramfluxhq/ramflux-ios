    "calls.permission.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Microphone access is managed in iOS Settings. This screen reads the current permission without requesting access."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "麦克风权限由 iOS 设置管理。此页面仅查看当前权限，不会请求访问。"
          }
        }
      }
    },
    "calls.mute": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mute microphone"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "麦克风静音"
          }
        }
