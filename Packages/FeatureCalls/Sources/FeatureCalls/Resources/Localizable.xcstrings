{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "calls.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calls"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "通话"
          }
        }
      }
    },
    "calls.history": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Call history"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "通话记录"
          }
        }
      }
    },
    "calls.empty": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No call records"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无通话记录"
