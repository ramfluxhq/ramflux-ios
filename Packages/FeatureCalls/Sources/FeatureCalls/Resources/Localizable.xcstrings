    "calls.confirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm this call action"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "确认此通话操作"
          }
        }
      }
    },
    "calls.cancel": {
      "comment": "Button that cancels a pending call action.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
