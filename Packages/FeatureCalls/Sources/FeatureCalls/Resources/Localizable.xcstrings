    "calls.applying": {
      "comment": "Progress label while a call action is sent.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applying signaling action"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "正在执行信令操作"
