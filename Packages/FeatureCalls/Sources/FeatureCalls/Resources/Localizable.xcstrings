    "calls.peerFailure": {
      "comment": "Call end reason: the other side reported a failure.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Peer-reported failure"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "对方报告的故障"
          }
        }
      }
