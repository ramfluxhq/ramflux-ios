    "calls.declined": {
      "comment": "Call outcome: declined.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Declined"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "已拒绝"
          }
        }
      }
    },
    "calls.completed": {
      "comment": "Call outcome: completed normally.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Completed"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "已完成"
          }
        }
      }
    },
    "calls.cancelled": {
      "comment": "Call outcome: cancelled by the caller.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelled"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "已取消"
          }
        }
      }
    },
    "calls.missed": {
      "comment": "Call outcome: missed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Missed"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "未接听"
          }
        }
      }
    },
    "calls.busy": {
      "comment": "Call outcome: the other person was busy.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Busy"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "忙线"
          }
        }
      }
