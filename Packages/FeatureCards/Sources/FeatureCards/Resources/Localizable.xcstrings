{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "cards.contentUnavailable": {
      "comment": "Shown in an agent card when its content cannot be displayed and it has no fallback text.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Card content unavailable"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "卡片内容不可用"
          }
        }
      }
    },
    "cards.closed": {
      "comment": "Note under an agent card that no longer accepts actions.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This card is closed"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此卡片已关闭"
          }
        }
      }
    },
    "cards.outOfSync": {
      "comment": "Note under an agent card whose state is out of sync; its controls are disabled.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This card is out of sync; actions are paused"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此卡片未同步，操作已暂停"
          }
        }
      }
    },
    "cards.sending": {
      "comment": "Progress line while an action from an agent card is sent.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sending…"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "正在发送…"
          }
        }
      }
    },
    "cards.streaming": {
      "comment": "Accessibility label of the indicator while the agent is still writing this text.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Still writing"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "仍在输入"
          }
        }
      }
    },
    "cards.unsupportedValue": {
      "comment": "Placeholder for a value in an agent card that this app cannot show.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not shown in this app"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此应用无法显示"
          }
        }
      }
    },
    "cards.unsupported": {
      "comment": "Placeholder for a part of an agent card that this app cannot show; the card's summary follows.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This part of the card is not supported in this app"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此应用不支持卡片的这一部分"
          }
        }
      }
    },
    "cards.link": {
      "comment": "Placeholder for a link button in an agent card whose destination cannot be opened safely.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This link cannot be opened"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开此链接"
          }
        }
      }
    },
    "cards.approval.pending": {
      "comment": "Status of an approval card; the decision is made in the task or approval screen.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Decide in tasks"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "请在任务中决定"
          }
        }
      }
    },
    "cards.approval.request": {
      "comment": "Label of the request reference in an approval card.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Request"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "请求"
          }
        }
      }
    },
    "cards.link.confirm.title": {
      "comment": "Title of the confirmation before opening a link from an agent card. %@ is the destination host, for example example.com.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open a page on %@?"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "要打开 %@ 上的网页吗？"
          }
        }
      }
    },
    "cards.link.confirm.message": {
      "comment": "Explains the link confirmation: the page opens in the browser and the agent chose the destination.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The agent chose this link. It opens in your browser; check the address before you continue."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此链接由智能体提供，将在浏览器中打开。继续前请核对网址。"
          }
        }
      }
    },
    "cards.link.open": {
      "comment": "Button in the link confirmation that opens the page.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "打开"
          }
        }
      }
    },
    "cards.link.cancel": {
      "comment": "Button in the link confirmation that closes it without opening the page.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "cards.chip.submitting": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Submitting..."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "提交中..."
          }
        }
      }
    },
    "cards.chip.waiting": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for confirmation"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "等待确认"
          }
        }
      }
    },
    "cards.chip.waitingForYou": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for you"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "等待你处理"
          }
        }
      }
    },
    "cards.chip.closed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closed"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "已关闭"
          }
        }
      }
    },
    "cards.chip.updated": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updated"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "已更新"
          }
        }
      }
    },
    "cards.chip.refused": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not send"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "发送失败"
          }
        }
      }
    },
    "cards.refused.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not send. Your input is kept."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "发送失败，你的输入已保留。"
          }
        }
      }
    },
    "cards.superseded.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Content updated"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "内容已更新"
          }
        }
      }
    },
    "cards.superseded.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The version you saw has changed. Review the new version before deciding."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "你看到的版本已变化。请先查看新版本再做决定。"
          }
        }
      }
    },
    "cards.resync": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resync"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "重新同步"
          }
        }
      }
    },
    "cards.list.empty": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing to show"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "没有内容"
          }
        }
      }
    },
    "cards.list.showAll": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show all (%lld)"
          }
