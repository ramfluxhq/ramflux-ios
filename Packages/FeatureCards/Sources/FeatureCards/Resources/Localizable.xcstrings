          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "步骤（%1$lld / %2$lld）"
          }
        }
      }
    },
    "cards.task.refusedNote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The task ended. Steps are kept."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "任务已结束，步骤已保留。"
          }
        }
      }
