          "stringUnit": {
            "state": "translated",
            "value": "允许"
          }
        }
      }
    },
    "cards.approval.deny": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deny"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "拒绝"
          }
        }
      }
    },
    "cards.approval.confirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "确认"
          }
        }
      }
    },
    "cards.approval.sheetTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm this approval"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "确认此审批"
          }
        }
      }
    },
    "cards.approval.requester": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requested by %@"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "请求人：%@"
          }
        }
      }
    },
    "cards.approval.risk": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Risk: %@"
          }
