    "chat.storage.clearFact": {
      "comment": "Confirmation text before clearing downloaded media.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloaded photos, videos and files are removed from this device. Items older than a day may no longer be available to download again. Messages waiting to be sent are kept."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "已下载的照片、视频和文件将从本设备移除。超过一天的内容可能无法再次下载。等待发送的消息会保留。"
          }
        }
      }
    },
    "chat.storage.title": {
      "comment": "Title of the media storage screen.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
