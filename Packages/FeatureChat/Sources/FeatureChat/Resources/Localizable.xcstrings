        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The other person needs to update Ramflux to receive attachments."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "对方需要更新 Ramflux 才能接收附件。"
