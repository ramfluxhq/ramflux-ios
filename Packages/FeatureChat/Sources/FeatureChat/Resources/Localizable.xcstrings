            "state": "translated",
            "value": "选择文本"
          }
        }
      }
    },
    "chat.media.cancelDownload": {
      "comment": "Accessibility action on a photo or video that is downloading: stops the download (sighted users tap the spinner).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
