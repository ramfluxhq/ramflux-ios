    },
    "chat.storage.policy": {
      "comment": "Explanation of the storage policy on the media storage screen.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloaded media stays on this device until you or the sender delete it, or you clear it here. Nothing is removed automatically."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "已下载的媒体会保留在本设备上，直到你或发送者删除，或你在此处清除。不会自动删除任何内容。"
          }
        }
      }
    },
    "chat.typing": {
      "comment": "Line above the composer while the other person is typing.",
