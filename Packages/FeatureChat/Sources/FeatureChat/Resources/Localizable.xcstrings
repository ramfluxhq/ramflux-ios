          }
        }
      }
    },
    "chat.storage.clear": {
      "comment": "Destructive button that removes downloaded media from this device.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear downloaded media"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "清除已下载的媒体"
