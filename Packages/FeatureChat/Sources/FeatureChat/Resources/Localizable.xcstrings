        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved to Photos"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "已存储到照片"
          }
        }
      }
    },
    "chat.media.saveFailed": {
      "comment": "Shown in the viewer when the photo could not be saved, for example because access was declined.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not save to Photos"
