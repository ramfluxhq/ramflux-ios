    },
    "chat.storage.clearAll": {
      "comment": "Storage screen button that removes all downloaded media of the account from this device.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear all downloaded media"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "清除全部已下载的媒体"
          }
        }
      }
