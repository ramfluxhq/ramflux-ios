{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "chat.message.react": {
      "comment": "Menu action on a message that adds an emoji reaction.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "React"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "表情回应"
          }
        }
      }
    },
    "common.action.refresh": {
      "comment": "Button that reloads the current screen from the account service.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "刷新"
          }
        }
      }
    },
    "chat.composer.placeholder": {
      "comment": "Placeholder in the empty message field.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Message"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "消息"
          }
        }
      }
    },
    "chat.empty.message": {
      "comment": "Explanation in an empty conversation.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Messages in this conversation will appear here."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此会话的消息将在这里显示。"
          }
        }
      }
    },
    "chat.message.edit": {
      "comment": "Menu action on an own message that edits its text.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑"
          }
        }
      }
    },
    "chat.delete.mine.fact": {
      "comment": "Warning when deleting a message only from the user's own devices: copies on other people's devices remain.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This does not erase copies on other people's devices."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作不会删除他人设备上的副本。"
          }
        }
      }
    },
    "chat.message.deleted": {
      "comment": "Placeholder for a message that was deleted.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Message deleted"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "消息已删除"
          }
        }
      }
    },
    "chat.message.callHistory": {
      "comment": "Label of a call-history entry in the conversation.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Call history"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "通话记录"
          }
        }
      }
    },
    "chat.send.retry": {
      "comment": "Button that retries a send whose outcome is unknown, reusing the original operation.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry original send"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "重试原始发送操作"
          }
        }
      }
    },
    "chat.delete.mine.summary": {
      "comment": "Summary of the confirmation that deletes a message from the user's own devices.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete message"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "删除消息"
          }
        }
      }
    },
    "chat.delete.mine.title": {
      "comment": "Question asking to confirm deletion from the user's own devices.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete from your own devices?"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "要从你自己的设备中删除吗？"
          }
        }
      }
    },
    "chat.send.submitted": {
      "comment": "Status after a message was handed to the account service.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Submitted to account service"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "已提交到账户服务"
          }
        }
      }
    },
    "chat.loading": {
      "comment": "Progress label while messages load.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading messages"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "正在加载消息"
          }
        }
      }
    },
    "chat.send.failed": {
      "comment": "Status when sending a message failed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delivery failed"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "发送失败"
          }
        }
      }
    },
    "common.action.reply": {
      "comment": "Button or menu action that starts a reply to a message or a request.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reply"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "回复"
          }
        }
      }
    },
    "chat.empty.title": {
      "comment": "Title of an empty conversation.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No messages yet"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无消息"
          }
        }
      }
    },
    "chat.message.deleteMine": {
      "comment": "Menu action that deletes a message from the user's own devices only.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete from my devices"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "从我的设备中删除"
          }
        }
      }
    },
    "chat.delete.everyone": {
      "comment": "Menu action that deletes a message for everyone in the conversation.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete for everyone"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "为所有人删除"
          }
        }
      }
    },
    "chat.delete.everyone.fact": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes the message for everyone in the conversation."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "这将为会话中的所有人移除该消息。"
          }
        }
      }
    },
    "chat.delete.everyone.summary": {
      "comment": "Summary of the confirmation that deletes a message for everyone.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete for everyone"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "为所有人删除"
          }
        }
      }
    },
    "chat.reply.banner": {
      "comment": "Banner above the composer while a reply is being written.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replying"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "正在回复"
          }
        }
      }
    },
    "chat.edit.banner": {
      "comment": "Banner above the composer while an own message is being edited.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Editing"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "正在编辑"
          }
        }
      }
    },
    "chat.composer.cancel": {
      "comment": "Button in the composer that cancels a reply or an edit.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "chat.reaction.add": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add reaction"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "添加表情"
          }
        }
      }
    },
    "chat.reaction.remove": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove reaction"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "移除表情"
          }
        }
      }
    },
    "chat.reaction.title": {
      "comment": "Title of the emoji reaction picker.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reaction"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "表情回应"
          }
        }
      }
    },
    "chat.edited": {
      "comment": "Small label on a message that was edited.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edited"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "已编辑"
          }
        }
      }
    },
    "chat.reply.quote": {
      "comment": "Small label above the quoted message inside a reply.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reply"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "回复"
          }
        }
      }
    },
    "chat.timeline.unreadDivider": {
      "comment": "Divider in the chat timeline above the first unread message.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unread messages below"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "以下为未读消息"
          }
        }
      }
    },
    "chat.delete.confirmSummary": {
      "comment": "Delete confirmation summary. %1$@ is the action summary, %2$@ is the message id shown left to right.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@"
          }
        }
      }
    }
  }
}
