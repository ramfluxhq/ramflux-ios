{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "chat.message.react": {
      "comment": "Menu action on a message that adds an emoji reaction.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "React"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "表情回应"
          }
        }
      }
    },
    "common.action.refresh": {
      "comment": "Button that reloads the current screen from the account service.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "刷新"
          }
        }
      }
    },
    "chat.composer.placeholder": {
      "comment": "Placeholder in the empty message field.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Message"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "消息"
          }
        }
      }
    },
    "chat.empty.message": {
      "comment": "Explanation in an empty conversation.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Messages in this conversation will appear here."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此会话的消息将在这里显示。"
          }
        }
      }
    },
    "chat.message.edit": {
      "comment": "Menu action on an own message that edits its text.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑"
          }
        }
      }
    },
    "chat.delete.mine.fact": {
      "comment": "Warning when deleting a message only from the user's own devices: copies on other people's devices remain.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This does not erase copies on other people's devices."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作不会删除他人设备上的副本。"
          }
        }
      }
    },
    "chat.message.deleted": {
      "comment": "Placeholder for a message that was deleted.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Message deleted"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "消息已删除"
          }
        }
      }
    },
    "chat.message.callHistory": {
      "comment": "Label of a call-history entry in the conversation.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Call history"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "通话记录"
          }
        }
      }
    },
    "chat.send.retry": {
      "comment": "Button that retries a send whose outcome is unknown, reusing the original operation.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry original send"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "重试原始发送操作"
          }
        }
      }
    },
    "chat.delete.mine.summary": {
      "comment": "Summary of the confirmation that deletes a message from the user's own devices.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete message"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "删除消息"
          }
        }
      }
    },
    "chat.delete.mine.title": {
      "comment": "Question asking to confirm deletion from the user's own devices.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete from your own devices?"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "要从你自己的设备中删除吗？"
          }
        }
      }
    },
    "chat.loading": {
      "comment": "Progress label while messages load.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading messages"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "正在加载消息"
          }
        }
      }
    },
    "common.action.reply": {
      "comment": "Button or menu action that starts a reply to a message or a request.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reply"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "回复"
          }
        }
      }
    },
    "chat.empty.title": {
      "comment": "Title of an empty conversation.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No messages yet"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无消息"
          }
        }
      }
    },
    "chat.message.deleteMine": {
      "comment": "Menu action that deletes a message from the user's own devices only.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete from my devices"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "从我的设备中删除"
          }
        }
      }
    },
    "chat.delete.everyone": {
      "comment": "Menu action that deletes a message for everyone in the conversation.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete for everyone"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "为所有人删除"
          }
        }
      }
    },
    "chat.delete.everyone.fact": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes the message for everyone in the conversation."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "这将为会话中的所有人移除该消息。"
          }
        }
      }
    },
    "chat.delete.everyone.summary": {
      "comment": "Summary of the confirmation that deletes a message for everyone.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete for everyone"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "为所有人删除"
          }
        }
      }
    },
    "chat.reply.banner": {
      "comment": "Banner above the composer while a reply is being written.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replying"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "正在回复"
          }
        }
      }
    },
    "chat.edit.banner": {
      "comment": "Banner above the composer while an own message is being edited.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Editing"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "正在编辑"
          }
        }
      }
    },
    "chat.composer.cancel": {
      "comment": "Button in the composer that cancels a reply or an edit.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "chat.reaction.add": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add reaction"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "添加表情"
          }
        }
      }
    },
    "chat.reaction.remove": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove reaction"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "移除表情"
          }
        }
      }
    },
    "chat.reaction.title": {
      "comment": "Title of the emoji reaction picker.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reaction"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "表情回应"
          }
        }
      }
    },
    "chat.edited": {
      "comment": "Small label on a message that was edited.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edited"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "已编辑"
          }
        }
      }
    },
    "chat.reply.quote": {
      "comment": "Small label above the quoted message inside a reply.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reply"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "回复"
          }
        }
      }
    },
    "chat.timeline.unreadDivider": {
      "comment": "Divider in the chat timeline above the first unread message.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unread messages below"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "以下为未读消息"
          }
        }
      }
    },
    "chat.delete.confirmSummary": {
      "comment": "Delete confirmation summary. %1$@ is the action summary, %2$@ is the message id shown left to right.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@"
          }
        }
      }
    },
    "chat.outbox.pending": {
      "comment": "Meta label on an own message bubble that is queued and waits for the connection before it is sent.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pending"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "待发送"
          }
        }
      }
    },
    "chat.outbox.sending": {
      "comment": "Meta label on an own message bubble while the app is handing it to the account service.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sending"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "发送中"
          }
        }
      }
    },
    "chat.outbox.failed": {
      "comment": "Red label under an own message that the account service refused; a Retry button follows it.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not sent"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "未发送"
          }
        }
      }
    },
    "chat.outbox.retry": {
      "comment": "Button under an unsent message that sends the same message again.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "重试"
          }
        }
      }
    },
    "chat.outbox.discard": {
      "comment": "Destructive menu action that removes an unsent message from this device without sending it.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete unsent message"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "删除未发送的消息"
          }
        }
      }
    },
    "chat.outbox.details": {
      "comment": "Accessibility label of the info button next to an unsent message; it opens the reason and the delete action.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send details"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "发送详情"
          }
        }
      }
    },
    "chat.offline.banner": {
      "comment": "Banner at the top of a chat while the account service cannot be reached and messages are queued.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline · messages will be sent when the connection returns"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "当前离线 · 消息将在恢复连接后发送"
          }
        }
      }
    },
    "chat.message.copy": {
      "comment": "Menu action that copies the text of a message to the clipboard.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy text"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "复制文字"
          }
        }
      }
    },
    "chat.message.actions": {
      "comment": "Accessibility action that opens the action menu of a message (reactions, reply, copy, edit, delete).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Message actions"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "消息操作"
          }
        }
      }
    },
    "chat.timeline.loadingOlder": {
      "comment": "Progress label at the top of the chat while earlier messages load.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading earlier messages"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "正在加载更早的消息"
          }
        }
      }
    },
    "chat.timeline.jumpToLatest": {
      "comment": "Button shown after scrolling far back in history; it returns to the newest messages.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jump to latest"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "回到最新"
          }
        }
      }
    },
    "chat.attachment.typeSize": {
      "comment": "Meta line of a file attachment: %1$@ is the file type such as PDF, %2$@ is the formatted size.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@"
          }
        }
      }
    },
    "chat.details.title": {
      "comment": "Title of the conversation details sheet opened from the chat header's more button.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversation details"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "会话详情"
          }
        }
      }
    },
    "chat.details.conversationID": {
      "comment": "Caption above the conversation identifier in the conversation details sheet.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversation ID"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "会话 ID"
          }
        }
      }
    },
    "chat.details.members": {
      "comment": "Section caption for the people in the conversation, in the conversation details sheet.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Members"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "成员"
          }
        }
      }
    },
    "chat.details.you": {
      "comment": "Member row for the account using this phone, in the conversation details sheet.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "你"
          }
        }
      }
    },
    "chat.details.groupMembers": {
      "comment": "Text in the details of a group conversation; members and roles are managed in the group screen.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the group to manage members and roles."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "请在群组中管理成员和角色。"
          }
        }
      }
    },
    "chat.details.mute": {
      "comment": "Switch label that mutes notifications for this conversation.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mute notifications"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "消息免打扰"
          }
        }
      }
    },
    "chat.details.muteUnknown": {
      "comment": "Shown when the account service has no mute state for this conversation yet.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mute state is not available for this conversation yet."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此会话暂时没有免打扰状态。"
          }
        }
      }
    },
    "chat.details.close": {
      "comment": "Button that closes the conversation details sheet.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "完成"
          }
        }
      }
    },
    "chat.media.untrusted": {
      "comment": "Notice on a photo from someone who is not a contact; nothing is downloaded or shown until the user asks.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From someone not in your contacts"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "来自非联系人"
          }
        }
      }
    },
    "chat.media.show": {
      "comment": "Button on a hidden photo preview from a non-contact; it shows the small preview carried in the message.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "显示"
          }
        }
      }
    },
    "chat.media.download": {
      "comment": "Button that downloads and decrypts an attachment.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "下载"
          }
        }
      }
    },
    "chat.media.tapToDownload": {
      "comment": "Line on an attachment that is not on this device yet; %@ is its formatted size.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to download, %@"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "点按下载，%@"
          }
        }
      }
    },
    "chat.media.downloading": {
      "comment": "State line of an attachment while it downloads; the service reports no percentage.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloading"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "正在下载"
          }
        }
      }
    },
    "chat.media.failed": {
      "comment": "State line of an attachment whose download failed; tapping it tries again.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download failed, tap to retry"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "下载失败，点按重试"
          }
        }
      }
    },
    "chat.media.expired": {
      "comment": "State line of an attachment the relay no longer keeps (the sender's 24-hour window passed).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No longer available"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "已不可用"
          }
        }
      }
    },
    "chat.media.removed": {
      "comment": "State line of an attachment the sender erased.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removed by sender"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "已被发送者删除"
          }
        }
      }
    },
    "chat.media.notAvailable": {
      "comment": "State line of an attachment this device has no key for, for example a device paired later.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not available on this device"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "在此设备上不可用"
          }
        }
      }
    },
    "chat.media.open": {
      "comment": "State line of an attachment that is on this device and opens when tapped.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to open"
          }
