{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "contacts.empty.title": {
      "comment": "Title when the contact list or the filter result is empty.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No contacts found"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到联系人"
          }
        }
      }
    },
    "contacts.strangers.batch": {
      "comment": "Button that opens actions for several stranger requests at once.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Batch actions"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "批量操作"
          }
        }
      }
    },
    "common.action.refresh": {
      "comment": "Button that reloads the current screen from the account service.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "刷新"
          }
        }
      }
    },
    "contacts.request.title": {
      "comment": "Title of the screen showing one request from someone who is not a contact.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stranger request"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "陌生人请求"
          }
        }
      }
    },
    "contacts.request.block": {
      "comment": "Button that blocks the sender of a request.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Block"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "屏蔽"
          }
        }
      }
    },
    "contacts.requests.empty.title": {
      "comment": "Title when there are no contact requests.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No requests"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无请求"
          }
        }
      }
    },
    "contacts.profile.title": {
      "comment": "Title of a contact's profile screen.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Contact"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "联系人"
          }
        }
      }
    },
    "contacts.strangers.title": {
      "comment": "Title of the list of requests from people who are not contacts.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strangers"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "陌生人"
          }
        }
      }
    },
    "contacts.decision.confirmOther": {
      "comment": "Question confirming a decline or block decision on an incoming request.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply this decision to this incoming request?"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "要对这条收到的请求执行此操作吗？"
          }
        }
      }
    },
    "contacts.filter.placeholder": {
      "comment": "Placeholder of the field that filters the contact list.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Filter contacts"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "筛选联系人"
          }
        }
      }
    },
    "contacts.request.firstContact": {
      "comment": "Label on a first-time request: never contacted before and identity not verified. Keep the separator style natural for the language.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First contact · identity not verified"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "首次联系 · 身份未验证"
          }
        }
      }
    },
    "contacts.strangers.replyNote": {
      "comment": "Note that replying to a stranger does not accept the request or add a contact.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replying does not accept a request or add a contact."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "回复不会接受请求或添加联系人。"
          }
        }
      }
    },
    "contacts.sent.title": {
      "comment": "Title of the list of requests the user has sent.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sent requests"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "已发送的请求"
          }
        }
      }
    },
    "contacts.request.accept": {
      "comment": "Button that accepts a contact request.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accept"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "接受"
          }
        }
      }
    },
    "contacts.add.action": {
      "comment": "Short button that opens the add-contact screen.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "添加"
          }
        }
      }
    },
    "contacts.add.title": {
      "comment": "Title of the screen for adding a contact.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add contact"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "添加联系人"
          }
        }
      }
    },
    "contacts.decision.applying": {
      "comment": "Progress label while a request decision is applied.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applying decision"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "正在执行操作"
          }
        }
      }
    },
    "contacts.request.decline": {
      "comment": "Button that declines a contact request.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Decline"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "拒绝"
          }
        }
      }
    },
    "contacts.add.send": {
      "comment": "Button that sends a contact request to the entered address.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send contact request"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "发送联系人请求"
          }
        }
      }
    },
    "contacts.loading": {
      "comment": "Progress label while contacts load.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading contacts"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "正在加载联系人"
          }
        }
      }
    },
    "contacts.request.missing": {
      "comment": "Shown when a request no longer exists; refreshing shows its current status.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This request is no longer present. Refresh for its current status."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此请求已不存在。刷新以查看最新状态。"
          }
        }
      }
    },
    "common.tab.contacts": {
      "comment": "Title of the Contacts screen and label of the header button that opens it.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Contacts"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "联系人"
          }
        }
      }
    },
    "contacts.request.report": {
      "comment": "Button that reports the sender of a request.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Report"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "举报"
          }
        }
      }
    },
    "common.action.reply": {
      "comment": "Button or menu action that starts a reply to a message or a request.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reply"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "回复"
          }
        }
      }
    },
    "contacts.reconcile": {
      "comment": "Button that checks the result of a contact action whose outcome is unknown.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconcile original contact action"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "核实原始联系人操作"
          }
        }
      }
    },
    "contacts.add.address": {
      "comment": "Field label on the add-contact screen: the person's principal id, their @username (looked up in the username directory), or their contact card (text or link) which also names their home node.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account address, @username or contact card"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "账户地址、@用户名或联系人名片"
          }
        }
      }
    },
    "contacts.empty.message": {
      "comment": "Explains how to add a contact by account address.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a contact using their account address."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "使用对方的账户地址添加联系人。"
          }
        }
      }
    },
    "contacts.profile.missing": {
      "comment": "Shown when a contact can no longer be found; asks to refresh.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This contact is unavailable. Refresh your contacts."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此联系人不可用。请刷新联系人列表。"
          }
        }
      }
    },
    "contacts.decision.confirmAccept": {
      "comment": "Question confirming acceptance of a request, which adds the account to contacts.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accept this request and add this account to your contacts?"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "要接受此请求并将此账户添加为联系人吗？"
          }
        }
      }
    },
    "contacts.requests.empty.message": {
      "comment": "Explains that incoming requests will be listed here.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requests for this account will appear here."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此账户的请求将在这里显示。"
          }
        }
      }
    },
    "request.sentStatus": {
      "comment": "Status of a sent contact request. %@ is the request state, for example Pending.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sent request · %@"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "已发送请求 · %@"
          }
        }
      }
    },
    "contacts.decision.summary": {
      "comment": "Summary on the confirmation of a request decision. %1$@ is the decision (Accept, Decline or Block), %2$@ is the sender display name, %3$@ is the sender account identifier.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@ · %3$@"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@ · %3$@"
          }
        }
      }
    },
    "contacts.profile.remove": {
      "comment": "Destructive button on a contact profile that removes the contact.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove contact"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "删除联系人"
          }
        }
      }
    },
    "contacts.profile.block": {
      "comment": "Button on a contact profile that blocks the contact.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Block contact"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "屏蔽联系人"
          }
        }
      }
    },
    "contacts.profile.unblock": {
      "comment": "Button on a blocked contact's profile that unblocks it.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unblock contact"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "取消屏蔽"
          }
        }
      }
    },
    "contacts.profile.blocked": {
      "comment": "Status on the profile of a blocked contact.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocked"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "已屏蔽"
          }
        }
      }
    },
    "contacts.change.confirm.remove": {
      "comment": "Confirmation text before removing a contact.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove this contact? You can add them again later with a new request."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "删除该联系人？之后可以重新发送请求添加。"
          }
        }
      }
    },
    "contacts.change.confirm.block": {
      "comment": "Confirmation text before blocking a contact.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Block this contact? They can no longer reach you until you unblock them."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "屏蔽该联系人？取消屏蔽之前，对方无法联系你。"
          }
        }
      }
    },
    "contacts.change.confirm.unblock": {
      "comment": "Confirmation text before unblocking a contact.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unblock this contact? They can reach you again."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "取消屏蔽该联系人？对方将可以再次联系你。"
          }
        }
      }
    },
    "contacts.change.applying": {
      "comment": "Progress label while a contact change is applied.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applying change"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "正在应用更改"
          }
        }
      }
    },
    "contacts.loadingMore": {
      "comment": "Progress label at the end of the contact or request list while the next page loads.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading more"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "正在加载更多"
          }
        }
      }
    },
    "contacts.myCard.title": {
      "comment": "Title of the screen (and the button opening it) that shows this account's own contact card to hand to someone.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My contact card"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "我的联系人名片"
          }
        }
      }
    },
    "contacts.myCard.explain": {
      "comment": "Explanation on the My contact card screen. The card is signed by the account and names its home node; it expires after seven days.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Someone who adds this card can reach you through your home node. It expires after seven days; open this screen again for a new one."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "对方添加此名片后，即可通过您的主节点联系您。名片七天后失效，届时请重新打开此页面获取新名片。"
          }
        }
      }
    },
    "contacts.myCard.qr": {
      "comment": "Accessibility label of the QR code image of this account's contact card.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "QR code of your contact card"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "您的联系人名片二维码"
          }
        }
      }
    },
    "contacts.myCard.share": {
      "comment": "Button that opens the system share sheet with this account's contact card link.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share contact card"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "分享联系人名片"
          }
        }
      }
    },
    "contacts.myCard.text": {
      "comment": "Label above the contact card shown as text (selectable), for pasting into another app.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Card as text"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "名片文本"
          }
        }
      }
    },
    "contacts.username.found": {
      "comment": "Add-contact result card: the directory found this @name. %@ is the name without the @.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Found @%@"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "找到 @%@"
          }
        }
      }
    },
    "contacts.username.send": {
      "comment": "Button that sends a contact request to the @name that was looked up.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send contact request"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "发送联系人请求"
          }
        }
      }
    },
    "contacts.username.lookup": {
      "comment": "Button that looks up an @name in the username directory before any request is sent.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look up"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "查找"
          }
        }
      }
    },
    "contacts.username.lookingUp": {
      "comment": "Shown while an @name is being looked up.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looking up…"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "正在查找…"
          }
        }
      }
    }
  }
}
