{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "contacts.empty.title": {
      "comment": "Title when the contact list or the filter result is empty.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No contacts found"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到联系人"
          }
        }
      }
    },
    "contacts.strangers.batch": {
      "comment": "Button that opens actions for several stranger requests at once.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Batch actions"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "批量操作"
          }
        }
      }
    },
    "common.action.refresh": {
      "comment": "Button that reloads the current screen from the account service.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "刷新"
          }
        }
      }
    },
    "contacts.request.title": {
      "comment": "Title of the screen showing one request from someone who is not a contact.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stranger request"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "陌生人请求"
          }
        }
      }
    },
    "contacts.safety.unavailable": {
      "comment": "Shown when the safety number of this contact cannot be read.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Safety details are unavailable for this contact."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此联系人的安全信息不可用。"
          }
        }
      }
    },
    "contacts.profile.notVerified": {
      "comment": "Status on a contact profile: the contact's identity has not been verified.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Identity not verified"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "身份未验证"
          }
        }
      }
    },
    "contacts.safety.notVerified": {
      "comment": "Status on the safety number screen: not verified yet.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not verified"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "未验证"
          }
        }
      }
    },
    "contacts.request.block": {
      "comment": "Button that blocks the sender of a request.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Block"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "屏蔽"
          }
        }
      }
    },
    "contacts.requests.empty.title": {
      "comment": "Title when there are no contact requests.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No requests"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无请求"
          }
        }
      }
    },
    "contacts.profile.title": {
      "comment": "Title of a contact's profile screen.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Contact"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "联系人"
          }
        }
      }
    },
    "contacts.safety.markCompared": {
      "comment": "Button the user taps after comparing the full safety number with the contact.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I compared this number"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "我已核对此号码"
          }
        }
      }
    },
    "contacts.add.notVerifiedNote": {
      "comment": "Note that sending a request does not verify the other account.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A request does not make the other account verified."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "发送请求并不表示对方账户已通过验证。"
          }
        }
      }
    },
    "contacts.strangers.title": {
      "comment": "Title of the list of requests from people who are not contacts.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strangers"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "陌生人"
          }
        }
      }
    },
    "contacts.safety.verified": {
      "comment": "Status on the safety number screen: verified.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verified"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "已验证"
          }
        }
      }
    },
    "contacts.decision.confirmOther": {
      "comment": "Question confirming a decline or block decision on an incoming request.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply this decision to this incoming request?"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "要对这条收到的请求执行此操作吗？"
          }
        }
      }
    },
    "contacts.safety.identityChanged": {
      "comment": "Warning that the contact's identity changed and the full number must be compared again.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Identity changed. Compare the complete number again."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "身份已更改。请重新核对完整号码。"
          }
        }
      }
    },
    "contacts.filter.placeholder": {
      "comment": "Placeholder of the field that filters the contact list.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Filter contacts"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "筛选联系人"
          }
        }
      }
    },
    "contacts.request.firstContact": {
      "comment": "Label on a first-time request: never contacted before and identity not verified. Keep the separator style natural for the language.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First contact · identity not verified"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "首次联系 · 身份未验证"
          }
        }
      }
    },
    "contacts.strangers.replyNote": {
      "comment": "Note that replying to a stranger does not accept the request or add a contact.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replying does not accept a request or add a contact."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "回复不会接受请求或添加联系人。"
          }
        }
      }
    },
    "contacts.sent.title": {
      "comment": "Title of the list of requests the user has sent.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sent requests"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "已发送的请求"
          }
        }
      }
    },
    "contacts.request.accept": {
      "comment": "Button that accepts a contact request.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accept"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "接受"
          }
        }
      }
    },
    "contacts.safety.title": {
      "comment": "Title of the safety number screen and label of a safety number value. A safety number is a long number both people compare to verify identities.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Safety number"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "安全号码"
          }
        }
      }
    },
    "contacts.profile.verified": {
      "comment": "Status on a contact profile: the contact's identity has been verified.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Identity verified"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "身份已验证"
          }
        }
      }
    },
    "contacts.safety.compareInstructions": {
      "comment": "Instruction to compare the safety number through another trusted channel, such as in person or by phone.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare this number through another trusted channel."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "请通过其他可信渠道核对此号码。"
          }
        }
      }
    },
    "contacts.add.action": {
      "comment": "Short button that opens the add-contact screen.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "添加"
          }
        }
      }
    },
    "contacts.add.title": {
      "comment": "Title of the screen for adding a contact.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add contact"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "添加联系人"
          }
        }
      }
    },
    "contacts.profile.viewSafety": {
      "comment": "Button that opens the contact's safety number.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View safety number"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "查看安全号码"
          }
        }
      }
    },
    "contacts.decision.applying": {
      "comment": "Progress label while a request decision is applied.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applying decision"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "正在执行操作"
          }
        }
      }
    },
    "contacts.request.decline": {
      "comment": "Button that declines a contact request.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Decline"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "拒绝"
          }
        }
      }
    },
    "contacts.add.send": {
      "comment": "Button that sends a contact request to the entered address.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send contact request"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "发送联系人请求"
          }
        }
      }
    },
    "contacts.loading": {
      "comment": "Progress label while contacts load.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading contacts"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "正在加载联系人"
          }
        }
      }
    },
    "contacts.request.missing": {
      "comment": "Shown when a request no longer exists; refreshing shows its current status.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This request is no longer present. Refresh for its current status."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此请求已不存在。刷新以查看最新状态。"
          }
        }
      }
    },
    "common.tab.contacts": {
      "comment": "Title of the Contacts screen and label of the header button that opens it.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Contacts"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "联系人"
          }
        }
      }
    },
    "contacts.request.report": {
      "comment": "Button that reports the sender of a request.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Report"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "举报"
          }
        }
      }
    },
    "common.action.reply": {
      "comment": "Button or menu action that starts a reply to a message or a request.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reply"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "回复"
          }
        }
      }
    },
    "contacts.reconcile": {
      "comment": "Button that checks the result of a contact action whose outcome is unknown.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconcile original contact action"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "核实原始联系人操作"
          }
        }
      }
    },
    "contacts.add.address": {
      "comment": "Field label for the other person's account address.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account address"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "账户地址"
          }
        }
      }
    },
    "contacts.empty.message": {
      "comment": "Explains how to add a contact by account address.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a contact using their account address."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "使用对方的账户地址添加联系人。"
          }
        }
      }
    },
    "contacts.profile.missing": {
      "comment": "Shown when a contact can no longer be found; asks to refresh.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This contact is unavailable. Refresh your contacts."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此联系人不可用。请刷新联系人列表。"
          }
        }
      }
    },
    "contacts.decision.confirmAccept": {
      "comment": "Question confirming acceptance of a request, which adds the account to contacts.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accept this request and add this account to your contacts?"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "要接受此请求并将此账户添加为联系人吗？"
          }
        }
      }
    },
    "contacts.requests.empty.message": {
      "comment": "Explains that incoming requests will be listed here.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requests for this account will appear here."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此账户的请求将在这里显示。"
          }
        }
      }
    },
    "request.sentStatus": {
      "comment": "Status of a sent contact request. %@ is the request state, for example Pending.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sent request · %@"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "已发送请求 · %@"
          }
        }
      }
    },
    "contacts.decision.summary": {
      "comment": "Summary on the confirmation of a request decision. %1$@ is the decision (Accept, Decline or Block), %2$@ is the sender display name, %3$@ is the sender account identifier.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@ · %3$@"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@ · %3$@"
          }
        }
      }
    }
  }
}
