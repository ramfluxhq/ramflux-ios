{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "conversations.account.current": {
      "comment": "Label for the account currently in use, shown in the conversation list header.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current account"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "当前账号"
          }
        }
      }
    },
    "common.tab.messages": {
      "comment": "Name of the Messages tab and title of the conversation list.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Messages"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "消息"
          }
        }
      }
    },
    "conversations.empty.title": {
      "comment": "Title when there are no conversations.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No conversations yet"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无会话"
          }
        }
      }
    },
    "common.action.refresh": {
      "comment": "Button that reloads the current screen from the account service.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "刷新"
          }
        }
      }
    },
    "conversations.empty.message": {
      "comment": "Explains that adding a contact starts a conversation.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add someone to your contacts to start a conversation."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "添加联系人即可开始会话。"
          }
        }
      }
    },
    "contacts.strangers.title": {
      "comment": "Title of the list of requests from people who are not contacts.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strangers"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "陌生人"
          }
        }
      }
    },
    "conversations.loading": {
      "comment": "Progress label while conversations load.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading conversations"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "正在加载会话"
          }
        }
      }
    },
    "common.tab.contacts": {
      "comment": "Title of the Contacts screen and label of the header button that opens it.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Contacts"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "联系人"
          }
        }
      }
    },
    "conversations.search.placeholder": {
      "comment": "Placeholder of the search field above the conversation list.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search messages"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索消息"
          }
        }
      }
    },
    "conversations.unread %llu": {
      "comment": "Accessibility description of the unread badge on a conversation row.",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%llu unread message"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%llu unread messages"
                }
              }
            }
          }
        },
        "zh-CN": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%llu 条未读消息"
                }
              }
            }
          }
        }
      }
    }
  }
}
