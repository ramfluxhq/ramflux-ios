{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "common.tab.messages": {
      "comment": "Title of the chat list.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chats"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "聊天"
          }
        }
      }
    },
    "conversations.empty.title": {
      "comment": "Title of the empty conversation list.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No chats yet"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有聊天"
          }
        }
      }
    },
    "conversations.empty.message": {
      "comment": "Explains under the empty conversation list that adding a contact starts a conversation once they accept.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a contact to start a chat. Once they accept, the chat appears here."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "添加联系人后就可以开始聊天。对方接受后，聊天会出现在这里。"
          }
        }
      }
    },
    "contacts.strangers.title": {
      "comment": "Title of the list of requests from people who are not contacts.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strangers"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "陌生人"
          }
        }
      }
    },
    "conversations.loading": {
      "comment": "Progress label while conversations load.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading chats"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "正在加载聊天"
          }
        }
      }
    },
    "common.tab.contacts": {
      "comment": "Title of the Contacts screen and label of the header button that opens it.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Contacts"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "联系人"
          }
        }
      }
    },
    "conversations.search.placeholder": {
      "comment": "Placeholder of the chat list search field.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search chats"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索聊天"
          }
        }
      }
    },
    "conversations.unread %llu": {
      "comment": "Accessibility description of the unread badge on a conversation row.",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%llu unread message"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%llu unread messages"
                }
              }
            }
          }
        },
        "zh-CN": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%llu 条未读消息"
                }
              }
            }
          }
        }
      }
    },
    "conversations.account.subtitle": {
      "comment": "Subtitle of the conversation list header. %@ is the display name of the account in use.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · Current account"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · 当前账户"
          }
        }
      }
    },
    "conversations.requests.pending %llu": {
      "comment": "Detail line of the message requests row: how many people who are not contacts are waiting.",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Messages from %llu person who is not a contact"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Messages from %llu people who are not contacts"
                }
              }
            }
          }
        },
        "zh-CN": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%llu 位非联系人的消息"
                }
              }
            }
          }
        }
      }
    },
    "conversations.time.yesterday": {
      "comment": "Time column of a conversation row whose last activity was yesterday.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yesterday"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "昨天"
          }
        }
      }
    },
    "conversations.action.new": {
      "comment": "Header button that starts a new conversation by choosing a contact.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New chat"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "新聊天"
          }
        }
      }
    },
    "conversations.action.more": {
      "comment": "Header button that opens more actions for the conversation list.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "更多"
          }
        }
      }
    },
    "conversations.loadingMore": {
      "comment": "Shown at the end of the conversation list while the next page loads.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading more chats"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "正在加载更多聊天"
          }
        }
      }
    },
    "conversations.order.note": {
      "comment": "Footnote at the end of the loaded conversation list: only loaded conversations are sorted by recent activity.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorted by recent activity among the chats loaded so far."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "按最近活动排序（仅限已加载的聊天）。"
          }
        }
      }
    },
    "conversations.empty.action": {
      "comment": "Button on the empty conversation list that opens contacts to add one.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add contact"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "添加联系人"
          }
        }
      }
    },
    "conversations.failure.retry": {
      "comment": "Button under the conversation list failure that loads the list again.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "重试加载"
          }
        }
      }
    },
    "conversations.forward.title": {
      "comment": "Title of the page that picks the conversation a message is forwarded to.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forward to"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "转发到"
          }
        }
      }
    },
    "conversations.forward.empty": {
      "comment": "Shown in the forward picker when there is no other conversation to forward to.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No other chats yet"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有其他聊天"
          }
        }
      }
    },
    "conversations.search.empty": {
      "comment": "Shown when the search matches no chat.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No chats match."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "没有匹配的聊天。"
          }
        }
      }
    }
  }
}
