      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Group creation acknowledged"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "群组创建已确认"
          }
        }
      }
    },
    "groups.created.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account service committed the group. This does not confirm delivery to other devices."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "账户服务已提交群组状态。这不表示其他设备已收到更新。"
