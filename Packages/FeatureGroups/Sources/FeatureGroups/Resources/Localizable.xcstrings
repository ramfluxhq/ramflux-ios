      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access has changed"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "访问权限已变化"
          }
        }
      }
    },
    "groups.accessChanged.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account service refused this operation. Refresh the group before continuing."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "账户服务拒绝了此操作。请刷新群组后再继续。"
