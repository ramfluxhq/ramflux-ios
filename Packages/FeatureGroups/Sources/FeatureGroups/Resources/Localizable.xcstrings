    "groups.waitingOwner.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The request is retained by the SDK. Group permissions have not been changed here."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "SDK 已保留此请求。此处尚未更改群组权限。"
