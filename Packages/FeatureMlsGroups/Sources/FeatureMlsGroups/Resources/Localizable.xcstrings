    "group.message.delete": {
      "comment": "MLS groups (group chat). English: \"`{group_id, post_id}` → `{state: committed, log_seq}` (assumed, Q10)\"",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "`{group_id, post_id}` → `{state: committed, log_seq}` (assumed, Q10)"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "Own posts with a `log_seq` only. The confirmation must be accepted first. While the call runs the row shows \"Deleting…\". The tombstone appears on the success reply or on `post_deleted`, whichever comes first."
          }
        }
      }
    },
