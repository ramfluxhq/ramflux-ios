    "group.leave": {
      "comment": "MLS groups (leave confirmation). English: \"`{group_id}` → `{state: committed, log_seq}`\"",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "`{group_id}` → `{state: committed, log_seq}`"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "The confirmation must be accepted first. On `committed`: the group becomes read-only (\"You left this group\") and the composer is removed. The group leaves the list on the `membership` event `left` for `is_me`, or on the next list refresh that no longer contains it (Q13)."
          }
        }
      }
    },
