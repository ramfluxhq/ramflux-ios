    "group.create.approvalOffHelp": {
      "comment": "MLS groups (create sheet). English: \"Anyone with the link can join. A join completes only while a member's device or an agent is online.\"",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anyone with the link can join. A join completes only while a member's device or an agent is online."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "任何持有链接的人都可以加入。只有在某位成员的设备或智能体在线时，加入才能完成。"
          }
        }
      }
    },
    "group.create.approvalOnHelp": {
      "comment": "MLS groups (create sheet). English: \"An admin approves each request before someone joins.\"",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An admin approves each request before someone joins."
