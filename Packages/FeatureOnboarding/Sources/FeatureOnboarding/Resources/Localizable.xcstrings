          "stringUnit": {
            "state": "translated",
            "value": "Unlock with account code"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "用账户码解锁"
          }
        }
      }
    },
    "onboarding.address.instructions": {
      "comment": "Explains the node address field.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the HTTPS address your node operator gave you. Only its origin is used."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "输入节点运营方提供的 HTTPS 地址。只会使用其源地址。"
          }
        }
      }
    },
    "onboarding.address.placeholder": {
      "comment": "Placeholder of the node address field.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "https://node.example"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "https://node.example"
          }
        }
      }
    },
    "onboarding.recover.fingerprint": {
      "comment": "Title of the warning above the account fingerprint during recovery.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the account fingerprint"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "核对账户指纹"
          }
        }
      }
    },
    "onboarding.welcome.headline.first": {
      "comment": "First line of the two-line headline on the first screens; the second line follows below it. Split the sentence where the language breaks naturally.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep conversations"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "让会话与协作"
          }
        }
      }
    },
    "onboarding.welcome.headline.second": {
      "comment": "Second line of the two-line headline on the first screens, shown under the first line.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "and collaboration connected"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "保持连接"
          }
        }
      }
    },
    "onboarding.a02.knownAccount": {
      "comment": "Label above the display name of the account being unlocked (an account created or restored on this phone).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account on this phone"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此手机上的账户"
          }
        }
      }
    },
    "onboarding.a02.forget": {
      "comment": "Button on the unlock screen: removes an account the SDK refused to unlock from this phone's list of known accounts. Nothing is deleted from the account itself.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove from this phone's list"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "从此手机的列表中移除"
          }
        }
      }
    },
    "onboarding.complete.connecting": {
      "comment": "Completion step after creating or unlocking an account while the SDK reports that networking is not live yet; it changes to Connected when it is.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local account is ready. Connecting to the network…"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "本地账户已就绪。正在连接网络…"
          }
        }
