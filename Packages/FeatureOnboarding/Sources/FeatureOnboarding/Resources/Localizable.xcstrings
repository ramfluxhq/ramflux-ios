    "node.operatorInstructions": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discovery is untrusted until you compare this fingerprint and enter the public key supplied by the node operator. HTTP is used only for signed discovery and public records; it does not establish the node’s identity."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "在核对指纹并输入节点运营方提供的公钥之前，发现结果不可信。HTTP 仅用于带签名的发现和公开记录，不代表节点身份已验证。"
          }
        }
      }
    },
