{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "onboarding.n01.header": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create an account"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "创建账号"
          }
        }
      }
    },
    "onboarding.n01.create": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create the account"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "创建账号"
          }
        }
      }
    },
    "onboarding.n01.name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Display name"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "显示名称"
          }
        }
      }
    },
    "onboarding.n01.name.note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This name is shown for the new account. You can change it later."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此名称用于新账号，之后可以修改。"
          }
        }
      }
    },
    "onboarding.n01.node": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Node"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "节点"
          }
        }
      }
    },
    "onboarding.n01.node.official": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ramflux official node"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "Ramflux 官方节点"
          }
        }
      }
    },
    "onboarding.n01.node.selected": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected node"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "已选择的节点"
          }
        }
      }
    },
    "onboarding.n01.phrase": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recovery phrase is created on this phone and shown only once. Have pen and paper ready."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复短语在这部手机上生成，并且只显示一次。请先准备好纸和笔。"
          }
        }
      }
    },
    "onboarding.stage.saveFailed": {
      "comment": "Title when the chosen node could not be saved. A node is the server the account connects to.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to save this node"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存此节点"
          }
        }
      }
    },
    "onboarding.phrase.accessibility": {
      "comment": "Accessibility label of the private view that shows the recovery phrase.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Private recovery phrase display"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "私密恢复助记词显示区域"
          }
        }
      }
    },
    "onboarding.stage.complete": {
      "comment": "Title when the new account is ready.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account is ready"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "账户已就绪"
          }
        }
      }
    },
    "onboarding.recover.existingPassphrase": {
      "comment": "Field label for the local passphrase of an account already on this phone.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Existing local passphrase"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "现有本地口令"
          }
        }
      }
    },
    "onboarding.connection.preserved": {
      "comment": "Reassurance that the last confirmed connection is kept after an error.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your last confirmed connection is preserved."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "上次已确认的连接已保留。"
          }
        }
      }
    },
    "onboarding.localUnlock.instructions": {
      "comment": "Instructions: choose a local passphrase, then enter the requested recovery words. Only one attempt is allowed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a local passphrase, then enter the three requested recovery words. Confirmation is a single attempt."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "设置本地口令，然后输入指定的三个助记词。确认操作仅可尝试一次。"
          }
        }
      }
    },
    "onboarding.complete.notConnected": {
      "comment": "Status when the account was created locally but the network connection is not confirmed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local account is ready. Network connection has not been confirmed."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "本地账户已就绪。网络连接尚未确认。"
          }
        }
      }
    },
    "onboarding.address.normalized": {
      "comment": "Label in front of the address the app will actually connect to, after cleanup of the entered address.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "连接到"
          }
        }
      }
    },
    "onboarding.recover.warning": {
      "comment": "Security warning on the recovery screen. Must not be shortened.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm this account fingerprint through a trusted channel. Recovery revokes all other devices. Enter your phrase only for recovery you started yourself."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "请通过可信渠道确认此账户指纹。恢复操作会撤销所有其他设备。仅在由你主动发起的恢复操作中输入助记词。"
          }
        }
      }
    },
    "onboarding.recover.scope": {
      "comment": "Note that recovery only resumes an account already stored on this phone.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovery resumes an account already stored on this phone."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复操作将继续使用此手机上已存储的账户。"
          }
        }
      }
    },
    "onboarding.address.connect": {
      "comment": "Button that accepts the cleaned-up address and connects to it.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to this origin"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "连接到此源地址"
          }
        }
      }
    },
    "onboarding.phrase.keepPrivate": {
      "comment": "Instruction to keep the recovery words private and offline; they will not be shown again.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep these words private and save them offline. They cannot be shown again in this ceremony."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "请妥善保密并离线保存这些助记词。在本次设置中，助记词只显示一次。"
          }
        }
      }
    },
    "onboarding.connection.editAddress": {
      "comment": "Button that goes back to edit the node address.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit node address"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑节点地址"
          }
        }
      }
    },
    "onboarding.complete.connected": {
      "comment": "Status when the new account is connected to the network.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "已连接"
          }
        }
      }
    },
    "common.appName": {
      "comment": "The product name. Keep it unchanged unless the product has an official localised name.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ramflux"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "Ramflux"
          }
        }
      }
    },
    "onboarding.node.other": {
      "comment": "Button that lets the user enter a different node.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Other node"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "其他节点"
          }
        }
      }
    },
    "onboarding.address.check": {
      "comment": "Button that checks the entered node address.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check address"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "检查地址"
          }
        }
      }
    },
    "onboarding.node.saved.message": {
      "comment": "Confirmation that the node's identity was saved.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account service saved this node's identity."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "账户服务已保存此节点的身份。"
          }
        }
      }
    },
    "onboarding.stage.localUnlock": {
      "comment": "Title and button for setting up the local unlock passphrase.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set up local unlock"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "设置本地解锁"
          }
        }
      }
    },
    "onboarding.complete.continue": {
      "comment": "Button that leaves setup and opens the app.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "继续"
          }
        }
      }
    },
    "onboarding.recover.phrase": {
      "comment": "Field label for the recovery phrase.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovery phrase"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复助记词"
          }
        }
      }
    },
    "onboarding.recover.accountID": {
      "comment": "Field label for the identifier of an account already stored on this phone.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Existing local account ID"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "现有本地账户 ID"
          }
        }
      }
    },
    "onboarding.stage.offline": {
      "comment": "Title when the phone is offline during setup.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are offline"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "当前离线"
          }
        }
      }
    },
    "onboarding.stage.recover": {
      "comment": "Title of the account recovery step.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recover your account"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复账户"
          }
        }
      }
    },
    "onboarding.welcome.primaryDevice": {
      "comment": "Note on the welcome screen that this phone can be the main device of the account.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone can be your primary device."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此手机可作为你的主要设备。"
          }
        }
      }
    },
    "onboarding.stage.saving": {
      "comment": "Title while the chosen node is being saved.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving your node"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "正在保存节点"
          }
        }
      }
    },
    "onboarding.localUnlock.passphrase": {
      "comment": "Field label for the new local passphrase.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local passphrase"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "本地口令"
          }
        }
      }
    },
    "onboarding.phrase.hideAndContinue": {
      "comment": "Button after writing down the recovery phrase: hides it and continues.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I saved it. Hide and continue"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "我已保存，隐藏并继续"
          }
        }
      }
    },
    "onboarding.link.title": {
      "comment": "Title and button for linking this phone to an account that already exists on another device.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Link an existing account"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "关联现有账户"
          }
        }
      }
    },
    "onboarding.stage.identity": {
      "comment": "Title of the step that shows the node's identity for checking.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the node identity"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "核对节点身份"
          }
        }
      }
    },
    "onboarding.recover.readFingerprint": {
      "comment": "Button that reads the account's fingerprint so the user can compare it.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read account fingerprint"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "读取账户指纹"
          }
        }
      }
    },
    "onboarding.busy": {
      "comment": "Progress label while a setup step runs.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please wait"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "请稍候"
          }
        }
      }
    },
    "onboarding.localUnlock.accountID": {
      "comment": "Field label for the local account identifier.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local account ID"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "本地账户 ID"
          }
        }
      }
    },
    "onboarding.node.useAsDefault": {
      "comment": "Button that makes the saved node the default for new accounts.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use as default node"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "设为默认节点"
          }
        }
      }
    },
    "onboarding.stage.verifying": {
      "comment": "Title while the node is being verified.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifying the node"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "正在验证节点"
          }
        }
      }
    },
    "onboarding.stage.configuration": {
      "comment": "Title of the step that reviews the connection settings.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review your connection"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "检查连接"
          }
        }
      }
    },
    "onboarding.create.title": {
      "comment": "Title and button for creating a new account.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create an account"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "创建账户"
          }
        }
      }
    },
    "onboarding.welcome.unlockSaved": {
      "comment": "Button that unlocks an account already saved on this phone.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock saved account"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "解锁已保存的账户"
          }
        }
      }
    },
    "onboarding.node.choose": {
      "comment": "Title and button for choosing the node the account connects to.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a node"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "选择节点"
          }
        }
      }
    },
    "onboarding.confirmPhrase.instructions": {
      "comment": "Instruction before the list of recovery word positions to enter, in order.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next, enter the words at these positions in order:"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "接下来，请按顺序输入以下位置的助记词："
          }
        }
      }
    },
    "onboarding.stage.checkingAddress": {
      "comment": "Title while the entered node address is checked.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the node address"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "检查节点地址"
          }
        }
      }
    },
    "common.secureInput.hostRequired": {
      "comment": "Shown where a secret must be typed into a protected field drawn by the app itself, for example in previews where that field cannot appear.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complete secure input in the iOS app."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "请在 iOS 应用中完成安全输入。"
          }
        }
      }
    },
    "onboarding.link.unavailable": {
      "comment": "Shown when linking is not available in this build; no QR code or pairing code is created.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Linking needs a registered phone pairing coordinator. This build does not create a QR code or pairing code."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "关联设备需要已注册的手机配对服务。此版本不会创建二维码或配对码。"
          }
        }
      }
    },
    "onboarding.stage.confirmPhrase": {
      "comment": "Title of the step that asks for some recovery words to confirm they were saved.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm your recovery phrase"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "确认恢复助记词"
          }
        }
      }
    },
    "onboarding.stage.verificationFailed": {
      "comment": "Title when the node could not be verified.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Node verification failed"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "节点验证失败"
          }
        }
      }
    },
    "onboarding.welcome.title": {
      "comment": "Headline of the first setup screen.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your conversations connected"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "保持会话畅通"
          }
        }
      }
    },
    "onboarding.cancel": {
      "comment": "Button that cancels account setup.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel setup"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "取消设置"
          }
        }
      }
    },
    "onboarding.address.field": {
      "comment": "Field label for a node address (the server the account connects to).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Node address"
          }
        },
        "zh-CN": {
          "stringUnit": {
