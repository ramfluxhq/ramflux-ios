    "copy.043a01d16971": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Private recovery phrase display"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "私密恢复助记词显示区域"
          }
        }
      }
    },
    "copy.04d3e7f2e48b": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account is ready"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "账户已就绪"
          }
        }
      }
    },
    "copy.04eef37abc74": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Existing local passphrase"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "现有本地口令"
          }
        }
      }
    },
    "copy.07af72e6141b": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your last confirmed connection is preserved."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "上次已确认的连接已保留。"
          }
        }
      }
    },
    "copy.0896fec51d88": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a local passphrase, then enter the three requested recovery words. Confirmation is a single attempt."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "设置本地口令，然后输入指定的三个助记词。确认操作仅可尝试一次。"
          }
        }
      }
    },
    "copy.0b547581bb84": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local account is ready. Network connection has not been confirmed."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "本地账户已就绪。网络连接尚未确认。"
          }
        }
      }
    },
    "copy.0caae4e9b4c4": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "连接到"
          }
        }
      }
    },
    "copy.103d79748699": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm this account fingerprint through a trusted channel. Recovery revokes all other devices. Enter your phrase only for recovery you started yourself."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "请通过可信渠道确认此账户指纹。恢复操作会撤销所有其他设备。仅在由你主动发起的恢复操作中输入助记词。"
          }
        }
      }
    },
    "copy.10f868719bac": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovery resumes an account already stored on this phone."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复操作将继续使用此手机上已存储的账户。"
          }
        }
      }
    },
    "copy.1710d243883c": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to this origin"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "连接到此源地址"
          }
        }
      }
    },
    "copy.1b01d88bd34d": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep these words private and save them offline. They cannot be shown again in this ceremony."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "请妥善保密并离线保存这些助记词。在本次设置中，助记词只显示一次。"
          }
        }
      }
    },
    "copy.1b2db98c4d8d": {
