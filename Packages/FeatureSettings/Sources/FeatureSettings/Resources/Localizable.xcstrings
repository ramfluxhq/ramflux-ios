    "pairing.compare.title": {
      "comment": "Heading: compare the seven symbols shown on both devices.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare the symbols"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "比对符号"
          }
        }
      }
    },
    "pairing.compare.body": {
      "comment": "Instruction for comparing the symbols on the two devices.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check that the new device shows the same seven symbols in the same order. If anything differs, someone else may be trying to join."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "确认新设备按相同顺序显示同样的七个符号。如有任何不同，可能有其他人在尝试加入。"
          }
        }
      }
    },
    "pairing.compare.match": {
      "comment": "Button: the symbols on both devices are the same.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They match"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "符号一致"
          }
        }
      }
    },
    "pairing.compare.mismatch": {
      "comment": "Button: the symbols differ; this stops linking on both devices.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They don't match"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "符号不一致"
          }
        }
      }
    },
    "pairing.review.title": {
      "comment": "Heading of the review of the joining device before approval.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approve this device?"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "批准此设备？"
          }
        }
      }
    },
    "pairing.review.body": {
      "comment": "Explains what approving the joining device means.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device below asks to join your account. Approving gives it the rights listed until the date shown; you can revoke it at any time in Devices."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "下面的设备请求加入你的账户。批准后，它将在显示的日期前拥有所列权限；你可以随时在设备中撤销。"
          }
        }
      }
    },
    "pairing.review.warning.title": {
      "comment": "Warning title before approving a new device.",
