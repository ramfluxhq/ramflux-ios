    "settings.backup.create.body": {
      "comment": "Explains that the backup archive is encrypted with a passphrase the user chooses and that it cannot be recovered.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The archive is encrypted with a passphrase you choose. You need it to restore the archive, and nobody can recover it for you."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "归档使用你设置的密码加密。恢复时需要此密码，任何人都无法帮你找回。"
          }
        }
      }
    },
    "settings.backup.create.action": {
      "comment": "Button that starts writing a backup archive.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create backup"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "创建备份"
          }
        }
      }
    },
    "settings.backup.restore.title": {
      "comment": "Section title on the backup screen: restore from a backup archive file.",
