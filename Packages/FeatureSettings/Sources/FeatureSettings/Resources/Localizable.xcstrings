      }
    },
    "settings.backup.restore.newInstall": {
      "comment": "Explains restoring an archive on a new install: the archive becomes an account on this phone.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a backup archive from Files. After it is checked with its passphrase, it becomes an account on this phone."
