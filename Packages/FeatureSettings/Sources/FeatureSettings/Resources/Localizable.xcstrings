        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for the new device…"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待新设备…"
          }
        }
      }
    },
    "pairing.waiting.peerConfirm": {
      "comment": "Progress: waiting for the other device to confirm the symbols.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for the other device to confirm the symbols…"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待另一台设备确认符号…"
          }
        }
      }
    },
    "pairing.waiting.proposal": {
      "comment": "Progress: waiting for the other device to send its request to join.",
