    "pairing.join.unavailable": {
      "comment": "Notice: linking THIS phone to another account (the joining side) is not available yet; only inviting other devices is.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Joining another account from this phone is not available yet: the app cannot yet receive the new device code that joining needs. This phone can invite other devices."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "暂不支持用这部手机加入其他账户：应用还无法接收加入所需的新设备代码。这部手机可以邀请其他设备。"
          }
        }
      }
    },
    "pairing.invitation.body": {
      "comment": "Instruction while the invitation QR code is shown.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the new device, choose to link to an existing account and scan this code. Keep this screen open until the devices are linked."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "在新设备上选择关联已有账户并扫描此二维码。在设备完成关联前请保持此页面打开。"
          }
        }
      }
    },
    "pairing.invitation.qrLabel": {
      "comment": "Accessibility label of the invitation QR code.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitation QR code for the new device"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "供新设备扫描的邀请二维码"
          }
        }
      }
    },
    "pairing.invitation.expires": {
      "comment": "Countdown under the invitation QR code; the argument is minutes and seconds, for example 4:59.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expires in %@"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 后过期"
          }
        }
      }
    },
    "pairing.invitation.secret": {
      "comment": "Warning: the invitation QR code is a one-time secret.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anyone who scans this code before the new device can try to join. Show it only to your new device."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "在新设备之前扫描此二维码的人都可以尝试加入。只向你的新设备出示。"
          }
        }
      }
    },
    "pairing.invitation.covered": {
      "comment": "Shown over the invitation QR code while the app is in the background or not focused.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The invitation is hidden while Ramflux is not in use."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "Ramflux 未在使用时，邀请会被隐藏。"
          }
        }
      }
