{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "backup.jobSummary": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@"
          }
        }
      }
    },
    "calls.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calls"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "通话"
          }
        }
      }
    },
    "cards.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Interactive cards"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "交互卡片"
          }
        }
      }
    },
    "settings.devices.link": {
      "comment": "Button that starts linking a new device to this account.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Link new device"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "关联新设备"
          }
        }
      }
    },
    "settings.privacy.retention.save": {
      "comment": "Button that saves the chosen message retention period.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save retention"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "保存保留时间"
          }
        }
      }
    },
    "common.action.refresh": {
      "comment": "Button that reloads the current screen from the account service.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "刷新"
          }
        }
      }
    },
    "settings.nodes.empty": {
      "comment": "Shown when the account service returned no saved nodes (servers).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No saved nodes were returned."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "未返回已保存的节点。"
          }
        }
      }
    },
    "settings.nodes.useAsDefault": {
      "comment": "Button that makes this node the default.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use as default"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "设为默认"
          }
        }
      }
    },
    "settings.account.lock": {
      "comment": "Button that locks the account now.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lock account"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "锁定账户"
          }
        }
      }
    },
    "settings.nodes.add": {
      "comment": "Button that adds a node (server).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add node"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "添加节点"
          }
        }
      }
    },
    "settings.busy": {
      "comment": "Progress label while a settings operation runs.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applying operation"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "正在执行操作"
          }
        }
      }
    },
    "settings.devices.revoke.fact": {
      "comment": "Warning that revoking stops future access but cannot erase what the device already read.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes future access. Previously read copies cannot be erased remotely."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作将撤销后续访问权限。已读取的副本无法远程擦除。"
          }
        }
      }
    },
    "settings.devices.noAccount": {
      "comment": "Shown when no account is open, so its devices cannot be listed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open an account to read its devices."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "打开账户以查看其设备。"
          }
        }
      }
    },
    "common.appName": {
      "comment": "The product name. Keep it unchanged unless the product has an official localised name.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ramflux"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "Ramflux"
          }
        }
      }
    },
    "settings.devices.webOriginWarning": {
      "comment": "Warning on a web device: the operator of that website can read its messages in plain text.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The origin's operator can read plaintext on this web device."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此源地址的运营方能够读取该网页设备上的明文。"
          }
        }
      }
    },
    "settings.backup.title": {
      "comment": "Title of the Backup and recovery settings section.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup and recovery"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "备份与恢复"
          }
        }
      }
    },
    "settings.appearance.theme": {
      "comment": "Label of the picker for light, dark or system appearance.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Appearance"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "外观"
          }
        }
      }
    },
    "settings.privacy.openAccount": {
      "comment": "Button for letting others reach this account by open account or username.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open account and username reachability"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "公开账户与用户名查找"
          }
        }
      }
    },
    "settings.about.exportDiagnostics": {
      "comment": "Button that exports diagnostics with private data removed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export sanitized diagnostics"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "导出脱敏诊断信息"
          }
        }
      }
    },
    "settings.loading": {
      "comment": "Progress label while settings load.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading settings"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "正在加载设置"
          }
        }
      }
    },
    "settings.devices.revoke": {
      "comment": "Button and confirmation summary for removing a linked device from the account.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Revoke device"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "撤销设备"
          }
        }
      }
    },
    "settings.privacy.title": {
      "comment": "Title of the Privacy settings section.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "隐私"
          }
        }
      }
    },
    "settings.about.title": {
      "comment": "Title of the About and diagnostics settings section.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About and diagnostics"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "关于与诊断"
          }
        }
      }
    },
    "settings.connectedServices.title": {
      "comment": "Title of the Connected services settings section (outside apps that can request actions).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected services"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "已连接的服务"
          }
        }
      }
    },
    "settings.nodes.default": {
      "comment": "Subtitle of the default node.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Default node"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "默认节点"
          }
        }
      }
    },
    "settings.appearance.system": {
      "comment": "Appearance option that follows the system light or dark setting.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "跟随系统"
          }
        }
      }
    },
    "settings.privacy.requireApproval": {
      "comment": "Button that switches contact requests from automatic acceptance back to manual approval.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Require manual approval"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "要求手动批准"
          }
        }
      }
    },
    "settings.devices.title": {
      "comment": "Title of the list of the user's own linked devices.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My devices"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "我的设备"
          }
        }
      }
    },
    "settings.title": {
      "comment": "Title of the Settings screen.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "设置"
          }
        }
      }
    },
    "settings.nodes.disabled": {
      "comment": "State of a node that is turned off.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disabled"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "已停用"
          }
        }
      }
    },
    "settings.nodes.title": {
      "comment": "Title of the list of nodes (servers) the account can use.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nodes"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "节点"
          }
        }
      }
    },
    "settings.privacy.retention.sevenDays": {
      "comment": "Retention option: messages are kept for seven days.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "7 days"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "7 天"
          }
        }
      }
    },
    "settings.connectedServices.manage": {
      "comment": "Button that opens the management of connected services.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manage services"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "管理服务"
          }
        }
      }
    },
    "settings.about.notificationPrivacy": {
      "comment": "Note that push notifications carry only a generic alert and no message preview.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications contain a generic alert. No message preview is sent through push."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "通知仅包含通用提醒，不通过推送发送消息预览。"
          }
        }
      }
    },
    "settings.nodes.enabled": {
      "comment": "State of a node that is turned on.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enabled"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "已启用"
          }
        }
      }
    },
    "settings.devices.linked": {
      "comment": "Subtitle of a device that is linked to the account but is not this phone.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Linked device"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "已关联的设备"
          }
        }
      }
    },
    "settings.about.license": {
      "comment": "Name of the software licence. Keep the licence identifier \"AGPL-3.0-or-later\" unchanged.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AGPL-3.0-or-later with App Store Exception"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "AGPL-3.0-or-later（附 App Store 例外条款）"
          }
        }
      }
    },
    "settings.account.networkLive": {
      "comment": "Status: the network connection is working.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Network connection is live"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "网络已连接"
          }
        }
      }
    },
    "settings.devices.missing": {
      "comment": "Shown when a device record can no longer be found; asks to refresh.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device record is unavailable. Refresh before continuing."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备记录不可用。请刷新后再继续。"
          }
        }
      }
    },
    "settings.devices.thisDevice": {
      "comment": "Subtitle of the device the user is holding.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备"
          }
        }
      }
    },
    "settings.privacy.retention.label": {
      "comment": "Label of the picker for how long newly sent messages are kept.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retention for newly sent messages"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "新发送消息的保留时间"
          }
        }
      }
    },
    "settings.appearance.title": {
      "comment": "Title of the Appearance and language settings section.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Appearance and language"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "外观与语言"
          }
        }
      }
    },
    "settings.privacy.retention.note": {
      "comment": "Note that changing retention does not affect messages already sent.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Existing messages keep their original retention."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "已有消息保持其原始保留时间。"
          }
        }
      }
    },
    "settings.devices.revoke.title": {
      "comment": "Question confirming removal of a linked device.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Revoke this device?"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "要撤销此设备吗？"
          }
        }
      }
    },
    "settings.account.title": {
      "comment": "Title of the Account and security settings section.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account and security"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "账户与安全"
          }
        }
      }
    },
    "settings.account.openOrCreate": {
      "comment": "Button shown when no account is open: open an existing account or create one.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open or create an account"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "打开或创建账户"
          }
        }
      }
    },
    "settings.account.networkUnconfirmed": {
      "comment": "Status: the network connection has not been confirmed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Network connection has not been confirmed"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "网络连接尚未确认"
          }
        }
      }
    },
    "settings.connectedServices.explanation": {
      "comment": "Explains that connected services can request actions and that each approval shows the exact operation and origin.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected services can request actions. Approvals must show the exact operation and origin in the native host."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "已连接的服务可以请求执行操作。批准界面必须在原生应用中显示确切操作和来源。"
          }
        }
      }
    },
    "settings.appearance.languageNote": {
      "comment": "Note that the app language is chosen in the system's per-app language setting.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Language follows the per-app language in system settings."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "语言跟随系统设置中为此应用选择的语言。"
          }
        }
      }
    },
    "settings.privacy.retention.oneHour": {
      "comment": "Retention option: messages are kept for one hour.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1 hour"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "1 小时"
          }
        }
      }
    },
    "settings.privacy.retention.oneDay": {
      "comment": "Retention option: messages are kept for one day.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1 day"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "1 天"
          }
        }
      }
    },
    "privacy.requestApproval": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Request approval: %@"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "请求批准方式：%@"
          }
        }
      }
    },
    "settings.pending": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An earlier Settings action is unresolved."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "之前的设置操作结果尚未确定。"
          }
        }
      }
    },
    "settings.reconcile": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconcile original action"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "核对原始操作"
          }
        }
      }
    },
    "settings.systemPermissions": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System permissions"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "系统权限"
          }
        }
      }
    },
    "settings.version": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %1$@ (build %2$@)"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "版本 %1$@（构建 %2$@）"
          }
        }
      }
    },
    "tasks.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasks"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "任务"
          }
        }
      }
    }
  }
}
