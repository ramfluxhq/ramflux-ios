    "settings.backup.create.title": {
      "comment": "Section title on the backup screen: write a backup of this account.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back up this account"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "备份此账号"
          }
        }
      }
