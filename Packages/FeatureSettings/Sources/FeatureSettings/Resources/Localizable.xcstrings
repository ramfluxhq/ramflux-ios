        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for the new device's request…"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待新设备的请求…"
          }
        }
      }
    },
    "pairing.waiting.install": {
      "comment": "Progress: the approved device is being added to the account at the node.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adding the device to your account…"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "正在将设备添加到你的账户…"
          }
        }
      }
