        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approve only your own device"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "只批准你自己的设备"
          }
        }
      }
    },
    "pairing.review.warning.body": {
      "comment": "Warning body before approving a new device.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A linked device can send and read messages for this account."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "已关联的设备可以为此账户收发消息。"
          }
