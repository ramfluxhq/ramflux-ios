    "pairing.title": {
      "comment": "Page title: link a new device (computer or tablet) to this account from this phone.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Link new device"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "关联新设备"
          }
        }
      }
    },
    "pairing.name.body": {
      "comment": "Explains the first step of linking a device from this phone, which is the account's primary device.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone is the account's primary device. Name the new device, then show the invitation to it. The new device joins with Ramflux on that device."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "这部手机是账户的主设备。为新设备命名，然后向它出示邀请。新设备在其上的 Ramflux 中加入。"
          }
        }
      }
    },
    "pairing.name.label": {
      "comment": "Label of the text field for the name the new device will have in the device list.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device name"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "设备名称"
          }
        }
      }
    },
    "pairing.name.placeholder": {
      "comment": "Placeholder example of a device name.",
