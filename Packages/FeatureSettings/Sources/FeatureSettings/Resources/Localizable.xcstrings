    "settings.backup.restore.body": {
      "comment": "Explains restoring an archive into the open account; the file is copied into the app's private storage.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a backup archive from Files. It is copied into this app's private storage and checked before anything changes."
