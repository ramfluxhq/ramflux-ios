    "pairing.failure.SasMismatch.body": {
      "comment": "Result text after the user said the symbols did not match.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The symbols did not match, so linking was stopped on both devices. If you did not expect this, someone else may have tried to join."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "符号不一致，两台设备上的关联均已停止。如果这不在你的预期之中，可能有其他人尝试加入。"
          }
        }
      }
    }
  }
