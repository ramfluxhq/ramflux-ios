{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "kit.load.readingRecords": {
      "comment": "Explanation while local records are read from storage.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading your local records"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "正在读取本地记录"
          }
        }
      }
    },
    "kit.load.retry": {
      "comment": "Button that retries loading after an error.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "重试"
          }
        }
      }
    },
    "kit.load.loading": {
      "comment": "Progress label while content loads.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "正在加载"
          }
        }
      }
    },
    "theme.light": {
      "comment": "Appearance option: light.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Light"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "浅色"
          }
        }
      }
    },
    "theme.dark": {
      "comment": "Appearance option: dark.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dark"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "深色"
          }
        }
      }
    },
    "confirmation.confirm": {
      "comment": "Button that confirms the displayed action.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "确认"
          }
        }
      }
    },
    "confirmation.cancel": {
      "comment": "Button that cancels a confirmation.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "confirmation.action": {
      "comment": "Accessibility label of the confirm button. %@ is the summary of the action being confirmed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm: %@"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "确认：%@"
          }
        }
      }
    },
    "kit.back": {
      "comment": "Accessibility label of the back button in a header.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "返回"
          }
        }
      }
    },
    "kit.call": {
      "comment": "Accessibility label of a header button that starts a call.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Call"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "通话"
          }
        }
      }
    },
    "kit.info": {
      "comment": "Accessibility label of a header button that opens details.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Info"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "信息"
          }
        }
      }
    },
    "kit.clear": {
      "comment": "Accessibility label of the button that clears a search field.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "清除"
          }
        }
      }
    },
    "kit.send": {
      "comment": "Accessibility label of the send button in the composer.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "发送"
          }
        }
      }
    },
    "kit.copy": {
      "comment": "Accessibility label of a button that copies a value.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "复制"
          }
        }
      }
    },
    "kit.close": {
      "comment": "Accessibility label of a close button.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭"
          }
        }
      }
    },
    "kit.more": {
      "comment": "Accessibility label of a header button that opens more actions.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "更多"
          }
        }
      }
    },
    "kit.search": {
      "comment": "Accessibility label of a search button or field.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索"
          }
        }
      }
    },
    "kit.attach": {
      "comment": "Accessibility label of the composer's plus button that opens the attach sheet (photos, camera, files).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attach"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "添加附件"
          }
        }
      }
    },
    "kit.receipt.pending": {
      "comment": "Accessibility value of an own message bubble whose send is pending (clock icon).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sending"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "正在发送"
          }
        }
      }
    },
    "kit.receipt.sent": {
      "comment": "Accessibility value of an own message bubble with one tick: sent, no device has confirmed delivery yet.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sent"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "已发送"
          }
        }
      }
    },
    "kit.receipt.delivered": {
      "comment": "Accessibility value of an own message bubble with two grey ticks: delivered to at least one device.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delivered"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "已送达"
          }
        }
      }
    },
    "kit.receipt.read": {
      "comment": "Accessibility value of an own message bubble with two ticks in the text colour: read on at least one device.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "已读"
          }
        }
      }
    },
    "kit.ai.marker": {
      "comment": "Short marker shown next to the name of a participant the app verified as an AI agent. Keep it to two or three characters.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "AI"
          }
        }
      }
    },
    "kit.ai.marker.accessibility": {
      "comment": "Spoken label of the AI marker next to a participant's name.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI agent"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 智能体"
          }
        }
      }
    },
    "kit.secret.show": {
      "comment": "Shows the text of one recovery word field.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "显示"
          }
        }
      }
    },
    "kit.secret.hide": {
      "comment": "Masks the text of one recovery word field again.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏"
          }
        }
      }
    }
  }
}
