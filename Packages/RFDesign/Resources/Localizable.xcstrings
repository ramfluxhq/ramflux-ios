  "strings": {
    "kit.secret.confirmOnce": {
      "comment": "Button under a protected secret field: submits it in a single attempt.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm once"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "确认（仅一次）"
          }
        }
      }
    },
    "kit.load.readingRecords": {
      "comment": "Explanation while local records are read from storage.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
