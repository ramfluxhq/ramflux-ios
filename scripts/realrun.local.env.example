#
# Copy to scripts/realrun.local.env (not tracked) and fill in the paths of your own test node and peers.
# scripts/realrun.sh reads it before each phase. Every value below is a placeholder.

# Node facts JSON: discovery_origin (for example http://192.0.2.10:8482), node_id, node_public_key,
# node_key_fingerprint.
RAMFLUX_REALRUN_NODE_FACTS=/path/to/test-node/node-facts.json
# Peers JSON: {"peers": [{"name": "alice", ...}, {"name": "bob", ...}]} with account_id, display_name,
# principal_id, principal_commitment, device_id and daemon_socket of each peer daemon.
RAMFLUX_REALRUN_PEERS=/path/to/test-node/peers.json
# The rf CLI built from the core product checkout.
RAMFLUX_REALRUN_RF=/path/to/product/target/release/rf
# Prints the direct conversation id of two root commitments: COMMAND dm-conversation ROOT_A ROOT_B
RAMFLUX_REALRUN_DM_HELPER="python3 -I /path/to/test-node/dm_conversation.py"

# Optional: a node health check, a peer daemon control command (status, start) and a node container
# whose clock is compared with this machine's.
#RAMFLUX_REALRUN_NODE_CHECK=/path/to/test-node/status.sh
#RAMFLUX_REALRUN_PEERS_CTL=/path/to/test-node/peers.sh
#RAMFLUX_REALRUN_CLOCK_CONTAINER=test-node-gateway
# Optional: a shell file with toolchain paths, sourced before building.
#RAMFLUX_MOBILE_ENV=/path/to/mobile-env.sh
